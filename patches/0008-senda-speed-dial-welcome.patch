+:root {
+  color-scheme: light;
+  --bg:#e6eef4;
+ --surface:#fff;
+ --ink:#20394d;
+ --muted:#52677a;
+  --seed:#285db5;
+ --accent:var(--seed);
+ --line:#b9cbdc;
+  --soft:color-mix(in srgb,var(--seed) 10%,var(--surface));
+ --error:#a62938;
+  font-family:'Segoe UI Variable','Segoe UI',sans-serif;
+ color:var(--ink);
+ background:var(--bg);
+}
+
+:root[data-palette='forest'] { --seed:#276b54; }
+
+:root[data-palette='clay'] { --seed:#a34b35; }
+
+:root[data-palette='violet'] { --seed:#7151a5; }
+
+:root[data-palette='slate'] { --seed:#526578; }
+
+:root[data-theme='dark'] {
+  color-scheme:dark;
+ --bg:#162332;
+ --surface:#22364a;
+ --ink:#ecf2f7;
+ --muted:#b5c6d6;
+  --line:#496176;
+ --accent:color-mix(in srgb,var(--seed) 45%,white);
+ --error:#ffabb5;
+}
+@media(prefers-color-scheme: dark) {
+  :root:not([data-theme='light']) {
+    color-scheme:dark;
+ --bg:#162332;
+ --surface:#22364a;
+ --ink:#ecf2f7;
+ --muted:#b5c6d6;
+    --line:#496176;
+ --accent:color-mix(in srgb,var(--seed) 45%,white);
+ --error:#ffabb5;
+  }
+}
