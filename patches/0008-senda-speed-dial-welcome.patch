+ padding:16px 40px 48px; }
+
+.welcome-intro { text-align:center; }
+
+.welcome-intro>img { width:64px;
+ height:64px; }
+
+.welcome-kicker { font-size:15px;
+ margin:16px 0 12px;
+ color:var(--muted); }
+
+.welcome h1 { font-size:clamp(36px,4.5vw,56px);
+ font-weight:500;
+ letter-spacing:-2px;
+ line-height:1.08;
+ margin:0 auto 18px;
+ max-width:560px; }
+
+.welcome-intro>p:last-child { font-size:16px;
+ margin:0;
+ color:var(--muted); }
+
+.welcome-features { display:grid;
+ grid-template-columns:repeat(3,minmax(0,1fr));
+ gap:28px;
+ margin:44px 0 34px;
+ padding:30px;
+ border-radius:24px;
+ background:color-mix(in srgb,var(--surface) 90%,transparent);
+ border:1px solid color-mix(in srgb,var(--surface) 80%,transparent); }
+
+.welcome-features h2 { font-size:16px;
+ margin:12px 0 8px;
+ font-weight:600; }
+
+.welcome-features p { color:var(--muted);
+ font-size:14px;
+ line-height:1.6;
+ margin:0; }
+
+.feature-mark { display:flex;
+ color:var(--accent); }
+
+.welcome-actions { text-align:center; }
+
+.welcome-actions .primary { min-height:46px;
+ padding:12px 24px; }
+
+.welcome-toggle { display:flex;
+ justify-content:center;
+ align-items:center;
+ gap:9px;
+ margin:22px 0 0;
+ font-size:13px; }
+
+.welcome-actions p { font-size:12px;
+ color:var(--muted);
+ margin:10px 0 0; }
+
+input[type='checkbox'] { accent-color:var(--seed);
+ width:17px;
+ height:17px; }
+
+dialog { padding:26px;
+ border:1px solid var(--line);
+ border-radius:20px;
+ background:var(--surface);
+ color:var(--ink);
+ width:min(440px,calc(100% - 32px));
+ box-shadow:0 28px 90px #0003; }
+
+dialog::backdrop { background:#0b1a3440; }
+
+.dialog-heading { display:flex;
+ align-items:center;
+ justify-content:space-between;
+ gap:12px; }
+
+.dialog-heading h2 { font-size:23px;
+ font-weight:500;
+ letter-spacing:-.5px;
+ margin:0; }
+
+.close { padding:0;
+ width:30px;
+ height:30px;
+ font-size:26px; }
+
+.dialog-copy { color:var(--muted);
+ font-size:14px;
+ margin:8px 0 24px; }
+
+dialog label { display:block;
+ font-size:13px;
+ margin:21px 0 8px; }
 
