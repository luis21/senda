+namespace {
+constexpr std::array<SkColor, 5> kSendaColors = {
+    SkColorSetRGB(40, 93, 181), SkColorSetRGB(39, 107, 84),
+    SkColorSetRGB(163, 75, 53), SkColorSetRGB(113, 81, 165),
+    SkColorSetRGB(82, 101, 120)};
+}  // namespace
+
+void NewTabPageHandler::GetSendaAppearance(
+    GetSendaAppearanceCallback callback) {
+  int32_t palette = -1;
+  const auto color = theme_service_->GetUserColor();
+  if (color && !theme_service_->UsingExtensionTheme() &&
+      !theme_service_->UsingDeviceTheme() && !theme_service_->GetIsGrayscale()) {
+    for (int32_t i = 0; i < 5; ++i) {
+      if (*color == kSendaColors[i]) {
+        palette = i;
+        break;
+      }
+    }
+  }
+  const bool editable = !theme_service_->UsingPolicyTheme() &&
+      !profile_->GetPrefs()->IsManagedPreference(prefs::kBrowserColorScheme) &&
+      !profile_->GetPrefs()->IsManagedPreference(prefs::kUserColor);
+  std::move(callback).Run(
+      static_cast<int32_t>(theme_service_->GetBrowserColorScheme()), palette,
+      editable);
+}
+
+void NewTabPageHandler::SetSendaAppearance(
+    int32_t scheme, int32_t palette, SetSendaAppearanceCallback callback) {
+  if (scheme < 0 || scheme > 2 || palette < -1 || palette > 4 ||
+      theme_service_->UsingPolicyTheme() ||
+      profile_->GetPrefs()->IsManagedPreference(prefs::kBrowserColorScheme) ||
+      profile_->GetPrefs()->IsManagedPreference(prefs::kUserColor)) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (palette >= 0) {
+    theme_service_->UseDeviceTheme(false);
+  }
+  if (palette >= 0 &&
+      (theme_service_->GetUserColor() != kSendaColors[palette] ||
+       theme_service_->UsingExtensionTheme() || theme_service_->GetIsGrayscale())) {
+    theme_service_->SetUserColor(kSendaColors[palette]);
+  }
+  theme_service_->SetBrowserColorScheme(
+      static_cast<ThemeService::BrowserColorScheme>(scheme));
+  std::move(callback).Run(true);
+}
+
