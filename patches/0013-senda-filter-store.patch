--- /dev/null
+++ b/chrome/browser/subresource_filter/senda_filter_store_unittest.cc
@@ -0,0 +1,159 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/subresource_filter/senda_filter_store.h"
+#include "base/files/file_util.h"
+#include "base/files/important_file_writer.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "crypto/hash.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace subresource_filter {
+namespace {
+std::string Hash(std::string_view bytes) {
+  return base::HexEncodeLower(crypto::hash::Sha256(bytes));
+}
+class SendaFilterStoreTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+  StageResult Stage(SendaFilterStore& store, std::string version = "202611170028") {
+    auto staging = store.CreateStagingDirectory();
+    GenerationManifest manifest;
+    for (size_t i = 0; i < 2; ++i) {
+      const auto* title = i == 0 ? "EasyList" : "EasyPrivacy";
+      auto data = std::string("[Adblock Plus 2.0]\n! Title: ") + title +
+                  "\n! Version: " + version + "\n" + std::string(1024, 'a');
+      EXPECT_TRUE(base::WriteFile(staging.AppendASCII(i ? "easyprivacy.txt" : "easylist.txt"), data));
+      manifest.sources[i].version = version;
+      manifest.sources[i].sha256 = Hash(data);
+    }
+    const std::string binary = "rules-" + version + std::string(1024, 'b');
+    EXPECT_TRUE(base::WriteFile(staging.AppendASCII("UnindexedRules"), binary));
+    EXPECT_TRUE(base::WriteFile(staging.AppendASCII("LICENSE"), "EasyList authors CC-BY-SA-3.0"));
+    manifest.ruleset_sha256 = Hash(binary);
+    manifest.ruleset_bytes = binary.size();
+    manifest.license_sha256 = Hash("EasyList authors CC-BY-SA-3.0");
+    return store.Stage(std::move(manifest), staging);
+  }
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(SendaFilterStoreTest, RecoversPreviousWhenActiveIsCorrupt) {
+  SendaFilterStore store(dir_.GetPath());
+  auto first = Stage(store);
+  ASSERT_TRUE(first.generation);
+  ASSERT_TRUE(store.CommitActive(first.generation->id));
+  auto second = Stage(store, "202611170029");
+  ASSERT_TRUE(second.generation);
+  ASSERT_TRUE(store.CommitActive(second.generation->id));
+  ASSERT_TRUE(base::WriteFile(second.generation->directory.AppendASCII("UnindexedRules"),
+                            std::string(second.generation->ruleset_bytes, 'x')));
+  auto recovered = store.Recover();
+  ASSERT_EQ(1u, recovered.generations.size());
+  EXPECT_EQ(first.generation->id, recovered.generations[0].id);
+  const auto source_path = first.generation->directory.AppendASCII("easylist.txt");
+  std::string source;
+  ASSERT_TRUE(base::ReadFileToString(source_path, &source));
+  source.back() = 'c';
+  ASSERT_TRUE(base::WriteFile(source_path, source));
+  EXPECT_TRUE(store.Recover().generations.empty());
+}
+
+TEST_F(SendaFilterStoreTest, InterruptedStageAndFailedPointerKeepActive) {
+  bool fail_writes = false;
+  SendaFilterStore store(dir_.GetPath(), base::BindRepeating(
+      [](bool* fail, const base::FilePath& path, std::string_view data) {
+        return !*fail && base::ImportantFileWriter::WriteFileAtomically(path, data);
+      }, &fail_writes));
+  auto first = Stage(store);
+  ASSERT_TRUE(first.generation);
+  ASSERT_TRUE(store.CommitActive(first.generation->id));
+  auto second = Stage(store, "202611170029");
+  ASSERT_TRUE(second.generation);
+  fail_writes = true;
+  EXPECT_FALSE(store.CommitActive(second.generation->id));
+  auto recovered = store.Recover();
+  ASSERT_FALSE(recovered.generations.empty());
+  EXPECT_EQ(first.generation->id, recovered.generations[0].id);
+}
+
+TEST_F(SendaFilterStoreTest, RejectsPathsOutsideOwnedRootAndUntrustedIds) {
+  auto root = dir_.GetPath().AppendASCII("owned");
+  auto outside = dir_.GetPath().AppendASCII("outside");
+  ASSERT_TRUE(base::CreateDirectory(outside));
+  ASSERT_TRUE(base::WriteFile(outside.AppendASCII("sentinel"), "keep"));
+  SendaFilterStore store(root);
+  EXPECT_FALSE(store.Stage(GenerationManifest(), outside).generation);
+  EXPECT_FALSE(store.CommitActive("../outside"));
+  EXPECT_FALSE(store.DiscardStaging(outside));
+  store.Prune();
+  EXPECT_TRUE(base::PathExists(outside.AppendASCII("sentinel")));
+}
+
+TEST_F(SendaFilterStoreTest, CorruptPointerAndUnsupportedManifestRecoverSafely) {
+  SendaFilterStore store(dir_.GetPath());
+  auto first = Stage(store);
+  ASSERT_TRUE(first.generation);
+  ASSERT_TRUE(store.CommitActive(first.generation->id));
+  ASSERT_TRUE(base::WriteFile(dir_.GetPath().AppendASCII("active.json"), "{partial"));
+  ASSERT_EQ(1u, store.Recover().generations.size());
+  const auto manifest_path = first.generation->directory.AppendASCII("manifest.json");
+  std::string metadata;
+  ASSERT_TRUE(base::ReadFileToString(manifest_path, &metadata));
+  const auto position = metadata.find("\"schema\":1");
+  ASSERT_NE(std::string::npos, position);
+  metadata.replace(position, 10, "\"schema\":99");
+  ASSERT_TRUE(base::WriteFile(manifest_path, metadata));
+  EXPECT_TRUE(store.Recover().generations.empty());
+}
+
+TEST_F(SendaFilterStoreTest, CanRehydrateSameContentAfterCorruption) {
+  SendaFilterStore store(dir_.GetPath());
+  auto first = Stage(store);
+  ASSERT_TRUE(first.generation);
+  ASSERT_TRUE(store.CommitActive(first.generation->id));
+  ASSERT_TRUE(base::WriteFile(first.generation->directory.AppendASCII("UnindexedRules"), "broken"));
+  auto repaired = Stage(store);
+  ASSERT_TRUE(repaired.generation);
+  EXPECT_EQ(first.generation->id, repaired.generation->id);
+  ASSERT_FALSE(store.Recover().generations.empty());
+}
+
+TEST_F(SendaFilterStoreTest, PruneProtectsActivePreviousAndAnOpenWindowsFile) {
+  SendaFilterStore store(dir_.GetPath());
+  auto first = Stage(store);
+  ASSERT_TRUE(first.generation);
+  ASSERT_TRUE(store.CommitActive(first.generation->id));
+  auto second = Stage(store, "202611170029");
+  ASSERT_TRUE(second.generation);
+  ASSERT_TRUE(store.CommitActive(second.generation->id));
+  auto third = Stage(store, "202611170030");
+  ASSERT_TRUE(third.generation);
+  ASSERT_TRUE(store.CommitActive(third.generation->id));
+  auto old_rules = first.generation->directory.AppendASCII("UnindexedRules");
+  base::File open(old_rules, base::File::FLAG_OPEN | base::File::FLAG_READ);
+  ASSERT_TRUE(open.IsValid());
+  store.Prune();
+  EXPECT_TRUE(base::PathExists(old_rules));
+  EXPECT_EQ(2u, store.Recover().generations.size());
+  open.Close();
+  store.Prune();
+  EXPECT_FALSE(base::PathExists(first.generation->directory));
+}
+
+TEST_F(SendaFilterStoreTest, RejectsHeaderInjectionInConditionalHttpMetadata) {
+  SendaFilterStore store(dir_.GetPath());
+  auto first = Stage(store);
+  ASSERT_TRUE(first.generation);
+  const auto staging = store.CreateStagingDirectory();
+  for (const auto* file : {"easylist.txt", "easyprivacy.txt", "UnindexedRules", "LICENSE"}) {
+    ASSERT_TRUE(base::CopyFile(first.generation->directory.AppendASCII(file), staging.AppendASCII(file)));
+  }
+  auto manifest = *first.generation;
+  manifest.sources[0].etag = "legitimate\r\nInjected: value";
+  EXPECT_FALSE(store.Stage(manifest, staging).generation);
+  EXPECT_TRUE(store.DiscardStaging(staging));
+}
