+  EXPECT_EQ(FilterUpdateOutcome::kUpdated, updater_->GetStatus().outcome);
+  EXPECT_NE(previous, updater_->GetStatus().generation_id);
+  Response(0, List(0, "202611150028")); Check();
+  EXPECT_EQ(FilterUpdateOutcome::kError, updater_->GetStatus().outcome);
+  EXPECT_EQ("202611170028", updater_->GetStatus().versions[0]);
+}
+TEST_F(SendaUpdaterTest, RequestsOmitCredentialsAndReferrer) {
+  factory_.SetInterceptor(base::BindRepeating([](const network::ResourceRequest& request) {
+    EXPECT_EQ(network::mojom::CredentialsMode::kOmit, request.credentials_mode);
+    EXPECT_TRUE(request.referrer.is_empty());
+    EXPECT_FALSE(request.headers.HasHeader("Cookie"));
+    EXPECT_TRUE(request.url == GURL(kUrls[0]) || request.url == GURL(kUrls[1]));
+  }));
