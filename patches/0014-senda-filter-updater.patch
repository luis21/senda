+TEST_F(SendaUpdaterTest, UpdatesAtomicallyAndReusesNotModifiedSources) {
+  Response(0, List(0)); Response(1, List(1));
+  Check();
+  ASSERT_EQ(FilterUpdateOutcome::kUpdated, updater_->GetStatus().outcome);
+  EXPECT_EQ(1, compiles_);
