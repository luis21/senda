+TEST_F(SendaUpdaterTest, HttpErrorsBackOffOneSixAndTwentyFourHours) {
+  factory_.SetInterceptor(base::BindRepeating([](size_t* count, const network::ResourceRequest&) {
+    ++*count;
+  }, &first_requests_));
+  Response(0, "error", 500); Check();
+  EXPECT_EQ(1u, first_requests_);
+  tasks_.FastForwardBy(base::Hours(1)); EXPECT_EQ(2u, first_requests_);
+  tasks_.FastForwardBy(base::Hours(6)); EXPECT_EQ(3u, first_requests_);
