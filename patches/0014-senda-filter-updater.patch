+TEST_F(SendaUpdaterTest, ExceptionOnlyChangesActivateButSourceRollbackIsRejected) {
+  Response(0, List(0)); Response(1, List(1)); Check();
+  const auto previous = updater_->GetStatus().generation_id;
+  Response(0, List(0, "202611170028", "@@||keep.test^$generichide\n"));
