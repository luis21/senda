+namespace subresource_filter {
+namespace {
+namespace proto = url_pattern_index::proto;
+std::string Snapshot(std::string selector = ".ad") {
+  std::string data;
+  {
+    google::protobuf::io::StringOutputStream stream(&data);
+    UnindexedRulesetWriter writer(&stream);
+    for (int i = 0; i < 1000; ++i) {
+      proto::UrlRule rule;
+      rule.set_url_pattern("blocked" + std::to_string(i) + ".test");
+      rule.set_url_pattern_type(proto::URL_PATTERN_TYPE_SUBSTRING);
+      rule.set_semantics(proto::RULE_SEMANTICS_BLOCKLIST);
+      rule.set_source_type(proto::SOURCE_TYPE_ANY);
+      rule.set_anchor_left(proto::ANCHOR_TYPE_NONE);
+      rule.set_anchor_right(proto::ANCHOR_TYPE_NONE);
+      rule.set_element_types(proto::ELEMENT_TYPE_SCRIPT);
+      writer.AddUrlRule(rule);
+    }
+    proto::StyleRule style;
+    style.set_semantics(proto::RULE_SEMANTICS_BLOCKLIST);
+    style.set_selector(selector);
+    style.add_classes("ad");
+    writer.AddStyleRule(style);
+    writer.SetCosmeticExceptions(proto::CosmeticExceptions());
+    writer.Finish();
+  }
+  return data;
+}
+TEST(SendaArtifactTest, ValidNativeSnapshotPasses) {
+  EXPECT_TRUE(ValidateSendaUnindexedRuleset(base::as_byte_span(Snapshot())));
+}
+TEST(SendaArtifactTest, RejectsCorruptFramingAndTruncationWithoutAllocatingDeclaredSize) {
+  const std::string oversized = "\xff\xff\xff\xff\x0f";
+  EXPECT_FALSE(ValidateSendaUnindexedRuleset(base::as_byte_span(oversized)));
+  auto truncated = Snapshot(); truncated.pop_back();
+  EXPECT_FALSE(ValidateSendaUnindexedRuleset(base::as_byte_span(truncated)));
+}
+TEST(SendaArtifactTest, SelectorsCannotInjectDeclarationsOrImportsFromAUtilityReply) {
+  EXPECT_FALSE(ValidateSendaUnindexedRuleset(base::as_byte_span(Snapshot(".ad{} @import 'https://invalid.test/x';"))));
+}
+TEST(SendaArtifactTest, RejectsOversizedRuleCountsBeforeProtobufAllocation) {
+  proto::FilteringRules chunk;
+  for (int i = 0; i < 65; ++i) {
+    auto* rule = chunk.add_url_rules();
+    rule->set_url_pattern("extra.test");
+    rule->set_url_pattern_type(proto::URL_PATTERN_TYPE_SUBSTRING);
+    rule->set_semantics(proto::RULE_SEMANTICS_BLOCKLIST);
+    rule->set_source_type(proto::SOURCE_TYPE_ANY);
+    rule->set_anchor_left(proto::ANCHOR_TYPE_NONE);
+    rule->set_anchor_right(proto::ANCHOR_TYPE_NONE);
+    rule->set_element_types(proto::ELEMENT_TYPE_SCRIPT);
+  }
+  const auto payload = chunk.SerializeAsString();
+  std::string data = Snapshot();
+  {
+    google::protobuf::io::StringOutputStream stream(&data);
+    google::protobuf::io::CodedOutputStream coded(&stream);
+    coded.WriteVarint32(payload.size());
+    coded.WriteRaw(payload.data(), payload.size());
+  }
+  EXPECT_FALSE(ValidateSendaUnindexedRuleset(base::as_byte_span(data)));
+}
+TEST(SendaArtifactTest, GenericReaderRejectsAnOverflowingChunkLength) {
+  const std::string bytes = "\xff\xff\xff\xff\x0f";
+  google::protobuf::io::ArrayInputStream stream(bytes.data(), bytes.size());
+  UnindexedRulesetReader reader(&stream);
+  proto::FilteringRules chunk;
+  EXPECT_FALSE(reader.ReadNextChunk(&chunk));
+  EXPECT_TRUE(reader.had_error());
+}
