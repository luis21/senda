+void RulesetService::PublishRuleset(const UnindexedRulesetInfo& info,
+                                    PublishCallback callback) {
+  if (info.content_version.empty() || !published_version_ || candidate_in_flight_) {
+    std::move(callback).Run({info.content_version, false});
+    return;
+  }
+  if (published_version_->content_version == info.content_version) {
+    std::move(callback).Run({info.content_version, true});
+    return;
+  }
+  candidate_in_flight_ = true;
+  if (previous_published_version_ && previous_published_version_->content_version == info.content_version) {
+    OpenCandidate(*previous_published_version_, std::move(callback));
+    return;
+  }
+  background_task_runner_->PostTaskAndReplyWithResult(FROM_HERE,
+      base::BindOnce(&RulesetService::IndexAndWriteRuleset, config_, indexed_ruleset_base_dir_, info),
+      base::BindOnce(&RulesetService::CandidateIndexed, weak_ptr_factory_.GetWeakPtr(),
+          info.content_version, std::move(callback)));
+}
+void RulesetService::CandidateIndexed(std::string expected, PublishCallback callback,
+                                      const IndexedRulesetVersion& version) {
+  if (!version.IsValid() || version.content_version != expected) {
+    candidate_in_flight_ = false;
+    std::move(callback).Run({expected, false});
+    return;
+  }
+  OpenCandidate(version, std::move(callback));
+}
+void RulesetService::OpenCandidate(IndexedRulesetVersion version, PublishCallback callback) {
+  const auto path = IndexedRulesetLocator::GetRulesetDataFilePath(
+      IndexedRulesetLocator::GetSubdirectoryPathForVersion(indexed_ruleset_base_dir_, version));
+  publisher_->TryOpenAndSetRulesetFile(path, version.checksum,
+      base::BindOnce(&RulesetService::CandidateOpened, weak_ptr_factory_.GetWeakPtr(),
+          version, std::move(callback)));
+}
+void RulesetService::CandidateOpened(IndexedRulesetVersion version, PublishCallback callback,
+                                     RulesetFilePtr file) {
+  if (!file->IsValid()) {
+    candidate_in_flight_ = false;
+    std::move(callback).Run({version.content_version, false});
+    return;
+  }
+  RecordPublication(version);
+  publisher_->PublishNewRulesetVersion(std::move(file));
+  candidate_in_flight_ = false;
+  std::move(callback).Run({version.content_version, true});
+}
+void RulesetService::RecordPublication(const IndexedRulesetVersion& version) {
+  if (!published_version_ || published_version_->content_version != version.content_version) {
+    previous_published_version_ = published_version_;
+    published_version_ = version;
+  }
+  version.SaveToPrefs(local_state_);
 }
 
