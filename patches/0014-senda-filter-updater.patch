diff --git a/components/subresource_filter/core/common/senda_ruleset_validator.cc b/components/subresource_filter/core/common/senda_ruleset_validator.cc
new file mode 100644
--- /dev/null
+++ b/components/subresource_filter/core/common/senda_ruleset_validator.cc
@@ -0,0 +1,102 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "components/subresource_filter/core/common/senda_ruleset_validator.h"
+#include <algorithm>
+#include <string_view>
+#include "base/strings/string_util.h"
+#include "components/url_pattern_index/proto/rules.pb.h"
+namespace subresource_filter {
+namespace {
+namespace proto = url_pattern_index::proto;
+constexpr size_t kFileLimit = 20 * 1024 * 1024;
+constexpr size_t kChunkLimit = 8 * 1024 * 1024;
+constexpr size_t kRuleLimit = 256 * 1024;
+constexpr size_t kMetadataLimit = 1024 * 1024;
+bool Varint(base::span<const uint8_t> bytes, size_t& offset, uint32_t& result) {
+  result = 0;
+  for (unsigned shift = 0; shift <= 28; shift += 7) {
+    if (offset == bytes.size()) { return false; }
+    const auto byte = bytes[offset++];
+    if (shift == 28 && (byte & 0xf0)) { return false; }
+    result |= static_cast<uint32_t>(byte & 127) << shift;
+    if (!(byte & 128)) { return true; }
+  }
+  return false;
+}
+bool Shape(base::span<const uint8_t> bytes) {
+  size_t offset = 0, rules = 0, metadata = 0;
+  while (offset < bytes.size()) {
+    uint32_t tag = 0, length = 0;
+    if (!Varint(bytes, offset, tag) || !Varint(bytes, offset, length) ||
+        length > bytes.size() - offset) { return false; }
+    if (tag == 10 || tag == 18) {
+      if (++rules > 64 || length > kRuleLimit) { return false; }
+    } else if (tag == 26) {
+      if (++metadata > 1 || length > kMetadataLimit) { return false; }
+    } else { return false; }
+    offset += length;
+  }
+  return true;
+}
+bool Text(std::string_view value) {
+  return value.size() <= 65536 && base::IsStringASCII(value) &&
+      std::ranges::none_of(value, [](unsigned char c) { return c < 32 || c == 127; });
+}
+bool Semantics(proto::RuleSemantics value) {
+  return value == proto::RULE_SEMANTICS_BLOCKLIST || value == proto::RULE_SEMANTICS_ALLOWLIST;
+}
+bool Metadata(const proto::CosmeticExceptions& metadata) {
+  size_t total = 0;
+  for (const auto* values : {&metadata.generic_domains(), &metadata.all_domains(),
+      &metadata.generic_prefixes(), &metadata.all_prefixes(),
+      &metadata.generic_url_substrings(), &metadata.all_url_substrings()}) {
+    if (values->size() > 16384) { return false; }
+    for (const auto& value : *values) {
+      total += value.size() + 8;
+      if (!Text(value) || total > kMetadataLimit) { return false; }
+    }
+  }
+  return true;
+}
+}  // namespace
+bool ValidateSendaUnindexedRuleset(base::span<const uint8_t> data) {
+  if (data.empty() || data.size() > kFileLimit) { return false; }
+  size_t offset = 0, network_rules = 0, style_rules = 0, metadata_count = 0;
+  while (offset < data.size()) {
+    uint32_t length = 0;
+    if (!Varint(data, offset, length) || !length || length > kChunkLimit ||
+        length > data.size() - offset) { return false; }
+    const auto bytes = data.subspan(offset, length);
+    if (!Shape(bytes)) { return false; }
+    proto::FilteringRules chunk;
+    if (!chunk.ParseFromArray(bytes.data(), bytes.size())) { return false; }
+    for (const auto& rule : chunk.url_rules()) {
+      if (++network_rules > 1000000 || rule.url_pattern().size() > 65536 ||
+          !Semantics(rule.semantics()) || rule.initiator_domains_size() > 8192 ||
+          rule.request_domains_size() > 8192 ||
+          rule.source_type() < proto::SOURCE_TYPE_ANY || rule.source_type() > proto::SOURCE_TYPE_FIRST_PARTY ||
+          (rule.url_pattern_type() != proto::URL_PATTERN_TYPE_SUBSTRING &&
+           rule.url_pattern_type() != proto::URL_PATTERN_TYPE_WILDCARDED)) { return false; }
+      for (const auto* domains : {&rule.initiator_domains(), &rule.request_domains()}) {
+        for (const auto& domain : *domains) { if (domain.domain().size() > 65536) { return false; } }
+      }
+    }
+    for (const auto& rule : chunk.style_rules()) {
+      if (++style_rules > 1000000 || !Text(rule.selector()) || rule.selector().empty() ||
+          rule.selector().find_first_of("{}@") != std::string::npos ||
+          rule.selector().contains("/*") || rule.selector().contains("*/") ||
+          !Semantics(rule.semantics()) || rule.domains_size() > 8192 ||
+          rule.classes_size() + rule.ids_size() > 16384) { return false; }
+      for (const auto* names : {&rule.classes(), &rule.ids()}) {
+        for (const auto& name : *names) { if (!Text(name)) { return false; } }
+      }
+      for (const auto& domain : rule.domains()) { if (domain.domain().size() > 65536) { return false; } }
+    }
+    if (chunk.has_cosmetic_exceptions()) {
+      if (++metadata_count != 1 || !Metadata(chunk.cosmetic_exceptions())) { return false; }
+    }
+    offset += length;
+  }
+  return network_rules >= 1000 && metadata_count == 1;
+}
+}  // namespace subresource_filter
