+}
+TEST_F(SendaUpdaterTest, LostCacheRefetchesAndRepairsTheSameGeneration) {
+  Response(0, List(0)); Response(1, List(1)); Check();
+  const auto id = updater_->GetStatus().generation_id;
+  const auto source = directory_.GetPath().AppendASCII("SendaFilterLists").AppendASCII(id).AppendASCII("easylist.txt");
+  ASSERT_TRUE(base::DeleteFile(source));
+  Response(0, "", 304); Response(1, "", 304);
