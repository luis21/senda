@@ -0,0 +1,116 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#ifndef CHROME_BROWSER_SUBRESOURCE_FILTER_SENDA_FILTER_UPDATER_H_
+#define CHROME_BROWSER_SUBRESOURCE_FILTER_SENDA_FILTER_UPDATER_H_
+#include <array>
+#include <memory>
+#include <optional>
+#include <string>
+#include "base/callback_list.h"
+#include "base/files/file.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/threading/sequence_bound.h"
+#include "base/time/time.h"
+#include "base/timer/timer.h"
+#include "chrome/browser/subresource_filter/senda_filter_store.h"
+#include "components/subresource_filter/tools/rule_parser/senda_filter_compiler.h"
+#include "services/network/public/cpp/shared_url_loader_factory.h"
+class PrefRegistrySimple;
+class PrefService;
+namespace network { class SimpleURLLoader; }
+namespace subresource_filter {
+enum class FilterUpdateOutcome { kNone, kUnchanged, kUpdated, kError };
+enum class FilterUpdatePhase { kLoading, kIdle, kDownloading, kCompiling, kPublishing };
+struct FilterUpdateStatus {
+  bool automatic = true;
+  FilterUpdatePhase phase = FilterUpdatePhase::kLoading;
+  FilterUpdateOutcome outcome = FilterUpdateOutcome::kNone;
+  std::array<std::string, 2> versions;
+  std::string generation_id;
+  base::Time last_check;
+  bool persistence_error = false;
+};
+struct BundledFilterSnapshot {
+  std::array<std::string, 2> versions;
+  std::string content_version;
+  std::string license;
+};
+class SendaFilterUpdater {
+ public:
+  using CompileCompletion = base::OnceCallback<void(CompileResult)>;
+  using Compiler = base::RepeatingCallback<void(base::File, base::File, base::File, CompileCompletion)>;
+  using PublishCompletion = base::OnceCallback<void(std::string, bool)>;
+  // nullopt explicitly requests the trusted bundled fallback, not network data.
+  using Publisher = base::RepeatingCallback<void(const std::optional<GenerationManifest>&, PublishCompletion)>;
+  SendaFilterUpdater(PrefService* local_state, const base::FilePath& user_data_dir,
+                     scoped_refptr<network::SharedURLLoaderFactory> factory,
+                     BundledFilterSnapshot bundled, Publisher publisher,
+                     Compiler compiler, base::RepeatingClosure cancel_compiler = {},
+                     SendaFilterStore::AtomicWriter store_writer = {});
+  ~SendaFilterUpdater();
+  SendaFilterUpdater(const SendaFilterUpdater&) = delete;
+  SendaFilterUpdater& operator=(const SendaFilterUpdater&) = delete;
+  static void RegisterLocalStatePrefs(PrefRegistrySimple* registry);
+  // Production calls Start only after the initial ruleset has been published.
+  void Start();
+  base::WeakPtr<SendaFilterUpdater> GetWeakPtr() { return lifetime_.GetWeakPtr(); }
+  void CheckNow();
+  void SetAutomaticUpdates(bool enabled);
+  FilterUpdateStatus GetStatus() const;
+  base::CallbackListSubscription Observe(base::RepeatingClosure callback);
+ private:
+  struct SourceHashes { bool valid = false; std::array<std::string, 2> hashes; };
+  struct CompilerFiles { base::File first, second, output; };
+  static SourceHashes HashSources(base::FilePath directory);
+  static CompilerFiles OpenCompilerFiles(base::FilePath directory);
+  void OnRecovered(RecoveryResult recovered);
+  void RestoreNext();
+  void OnRestored(std::string expected, std::string actual, bool success);
+  void Ready();
+  void Schedule();
+  std::string MinimumVersion(size_t index) const;
+  void Begin(base::FilePath staging);
+  void Download(size_t index, bool conditional);
+  void OnDownloaded(size_t index, bool conditional, base::FilePath file);
+  void OnCachedCopied(size_t index, bool success);
+  void SourceReady(size_t index, bool success);
+  void OnHashes(SourceHashes hashes);
+  void OnUnchangedCacheChecked(RecoveryResult recovered);
+  void CompileCandidate();
+  void OnCompilerFiles(CompilerFiles files);
+  void OnCompiled(CompileResult result);
+  void OnStaged(StageResult result);
+  void OnPublished(std::string expected, std::string actual, bool success);
+  void OnCommitted(bool success);
+  void OnRolledBack(std::string actual, bool success);
+  void Succeed(FilterUpdateOutcome outcome);
+  void Fail();
+  void Notify();
+  void SaveValidators();
+  void LoadValidators();
+  void CancelCompiler();
+  const raw_ptr<PrefService> prefs_;
+  const base::FilePath root_;
+  const scoped_refptr<network::SharedURLLoaderFactory> factory_;
+  const BundledFilterSnapshot bundled_;
+  const Publisher publisher_;
+  Compiler compiler_;
+  const base::RepeatingClosure cancel_compiler_;
+  base::SequenceBound<SendaFilterStore> store_;
+  FilterUpdateStatus status_;
+  RecoveryResult recovery_;
+  size_t restore_index_ = 0;
+  bool started_ = false, ready_ = false, manual_pending_ = false;
+  std::optional<GenerationManifest> active_, candidate_, prior_;
+  base::FilePath staging_;
+  std::array<FilterSourceInfo, 2> source_info_;
+  SourceHashes source_hashes_;
+  std::unique_ptr<network::SimpleURLLoader> loader_;
+  base::OneShotTimer timer_, compiler_timer_;
+  base::RepeatingClosureList observers_;
+  base::WeakPtrFactory<SendaFilterUpdater> lifetime_{this};
+  base::WeakPtrFactory<SendaFilterUpdater> operation_{this};
+};
+}  // namespace subresource_filter
+#endif
diff --git a/chrome/browser/subresource_filter/senda_filter_updater.cc b/chrome/browser/subresource_filter/senda_filter_updater.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/subresource_filter/senda_filter_updater.cc
@@ -0,0 +1,451 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/subresource_filter/senda_filter_updater.h"
+#include <algorithm>
+#include <utility>
+#include "base/files/file_util.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
+#include "base/task/thread_pool.h"
+#include "components/prefs/pref_registry_simple.h"
+#include "components/prefs/pref_service.h"
+#include "crypto/hash.h"
+#include "net/base/load_flags.h"
+#include "net/base/net_errors.h"
+#include "net/http/http_response_headers.h"
+#include "net/traffic_annotation/network_traffic_annotation.h"
+#include "net/url_request/redirect_info.h"
+#include "services/network/public/cpp/resource_request.h"
+#include "services/network/public/cpp/simple_url_loader.h"
+#include "services/network/public/mojom/url_response_head.mojom.h"
+
+namespace subresource_filter {
+namespace {
+constexpr char kAutomatic[] = "senda.filter_updates.automatic";
+constexpr char kLastCheck[] = "senda.filter_updates.last_check";
+constexpr char kRetryAfter[] = "senda.filter_updates.retry_after";
+constexpr char kFailures[] = "senda.filter_updates.failures";
+constexpr char kOutcome[] = "senda.filter_updates.outcome";
+constexpr char kVersions[] = "senda.filter_updates.versions";
+constexpr char kValidators[] = "senda.filter_updates.validators";
+constexpr std::array<const char*, 2> kUrls = {
+    "https://easylist.to/easylist/easylist.txt",
+    "https://easylist.to/easylist/easyprivacy.txt"};
+constexpr std::array<const char*, 2> kFiles = {"easylist.txt", "easyprivacy.txt"};
+constexpr size_t kSourceLimit = 20 * 1024 * 1024;
+std::string Hash(std::string_view text) {
+  return base::HexEncodeLower(crypto::hash::Sha256(text));
+}
+std::string HttpValidator(std::string value) {
+  return value.size() <= 8192 && base::IsStringUTF8(value) &&
+      std::ranges::none_of(value, [](unsigned char c) { return c < 32 || c == 127; })
+      ? value : std::string();
+}
+std::string SingleValidator(const net::HttpResponseHeaders& headers, std::string_view name) {
+  // ETag is non-coalescing: GetNormalizedHeader DCHECKs on it. Ignore
+  // ambiguous duplicates instead of synthesizing a different validator.
+  size_t iterator = 0;
+  const auto value = headers.EnumerateHeader(&iterator, name);
+  if (!value || headers.EnumerateHeader(&iterator, name)) { return {}; }
+  return HttpValidator(std::string(*value));
+}
+bool CopyCachedSource(base::FilePath from, base::FilePath to, std::string hash) {
+  std::string text;
+  return base::ReadFileToStringWithMaxSize(from, &text, kSourceLimit) &&
+      Hash(text) == hash && base::WriteFile(to, text);
+}
+bool WriteLicense(base::FilePath directory, std::string text) {
+  return !text.empty() && text.size() <= 128 * 1024 &&
+      base::WriteFile(directory.AppendASCII("LICENSE"), text);
+}
+}  // namespace
+
+SendaFilterUpdater::SendaFilterUpdater(PrefService* prefs, const base::FilePath& user_data_dir,
+    scoped_refptr<network::SharedURLLoaderFactory> factory, BundledFilterSnapshot bundled,
+    Publisher publisher, Compiler compiler, base::RepeatingClosure cancel_compiler,
+    SendaFilterStore::AtomicWriter store_writer)
+    : prefs_(prefs), root_(user_data_dir.AppendASCII("SendaFilterLists")),
+      factory_(std::move(factory)), bundled_(std::move(bundled)), publisher_(std::move(publisher)),
+      compiler_(std::move(compiler)), cancel_compiler_(std::move(cancel_compiler)),
+      store_(base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock(), base::TaskPriority::USER_VISIBLE}), root_, std::move(store_writer)) {
+  status_.versions = bundled_.versions;
+  status_.last_check = prefs_->GetTime(kLastCheck);
+  const auto outcome = prefs_->GetInteger(kOutcome);
+  if (outcome >= 0 && outcome <= static_cast<int>(FilterUpdateOutcome::kError)) {
+    status_.outcome = static_cast<FilterUpdateOutcome>(outcome);
+  }
+  CHECK(!compiler_.is_null());
+}
+SendaFilterUpdater::~SendaFilterUpdater() { CancelCompiler(); }
+
+void SendaFilterUpdater::RegisterLocalStatePrefs(PrefRegistrySimple* registry) {
+  registry->RegisterBooleanPref(kAutomatic, true);
+  registry->RegisterTimePref(kLastCheck, base::Time());
+  registry->RegisterTimePref(kRetryAfter, base::Time());
+  registry->RegisterIntegerPref(kFailures, 0);
+  registry->RegisterIntegerPref(kOutcome, 0);
+  registry->RegisterDictionaryPref(kVersions);
+  registry->RegisterDictionaryPref(kValidators);
+}
+FilterUpdateStatus SendaFilterUpdater::GetStatus() const {
+  auto status = status_;
+  status.automatic = prefs_->GetBoolean(kAutomatic);
+  return status;
+}
+base::CallbackListSubscription SendaFilterUpdater::Observe(base::RepeatingClosure callback) {
+  return observers_.Add(std::move(callback));
+}
+void SendaFilterUpdater::Notify() { observers_.Notify(); }
+void SendaFilterUpdater::Start() {
+  if (started_) { return; }
+  started_ = true;
+  store_.AsyncCall(&SendaFilterStore::Recover).Then(
+      base::BindOnce(&SendaFilterUpdater::OnRecovered, lifetime_.GetWeakPtr()));
+}
+void SendaFilterUpdater::OnRecovered(RecoveryResult recovered) {
+  recovery_ = std::move(recovered);
+  RestoreNext();
+}
+void SendaFilterUpdater::RestoreNext() {
+  if (restore_index_ < recovery_.generations.size()) {
+    const auto& generation = recovery_.generations[restore_index_];
+    publisher_.Run(generation, base::BindOnce(&SendaFilterUpdater::OnRestored,
+        lifetime_.GetWeakPtr(), generation.id));
+  } else {
+    publisher_.Run(std::nullopt, base::BindOnce(&SendaFilterUpdater::OnRestored,
+        lifetime_.GetWeakPtr(), std::string()));
+  }
+}
+void SendaFilterUpdater::OnRestored(std::string expected, std::string actual, bool success) {
+  if (expected.empty()) {
+    active_.reset();
+    status_.versions = success && actual.empty() ? bundled_.versions : std::array<std::string, 2>();
+    if (!success || !actual.empty()) { status_.outcome = FilterUpdateOutcome::kError; }
+    Ready();
+  } else if (success && expected == actual) {
+    active_ = recovery_.generations[restore_index_];
+    status_.versions = {active_->sources[0].version, active_->sources[1].version};
+    status_.generation_id = active_->id;
+    store_.AsyncCall(&SendaFilterStore::CommitActive).WithArgs(active_->id).Then(
+        base::BindOnce([](base::WeakPtr<SendaFilterUpdater> self, bool written) {
+          if (self) {
+            if (!written) { self->status_.outcome = FilterUpdateOutcome::kError; }
+            self->Ready();
+          }
+        }, lifetime_.GetWeakPtr()));
+  } else {
+    ++restore_index_;
+    RestoreNext();
+  }
+}
+void SendaFilterUpdater::Ready() {
+  recovery_ = {};
+  ready_ = true;
+  status_.phase = FilterUpdatePhase::kIdle;
+  LoadValidators();
+  Notify();
+  if (manual_pending_) {
+    manual_pending_ = false;
+    CheckNow();
+  } else if (prefs_->GetBoolean(kAutomatic)) {
+    timer_.Start(FROM_HERE, base::Minutes(1),
+        base::BindOnce(&SendaFilterUpdater::Schedule, lifetime_.GetWeakPtr()));
+  }
+}
+void SendaFilterUpdater::SetAutomaticUpdates(bool enabled) {
+  prefs_->SetBoolean(kAutomatic, enabled);
+  timer_.Stop();
+  Notify();
+  if (enabled && ready_ && status_.phase == FilterUpdatePhase::kIdle) { Schedule(); }
+}
+void SendaFilterUpdater::Schedule() {
+  if (!prefs_->GetBoolean(kAutomatic) || !ready_ || status_.phase != FilterUpdatePhase::kIdle) { return; }
+  const auto failures = std::clamp(prefs_->GetInteger(kFailures), 0, 3);
+  const auto delay = failures == 1 ? base::Hours(1) : failures == 2 ? base::Hours(6) : base::Days(1);
+  const auto last = prefs_->GetTime(kLastCheck);
+  const auto now = base::Time::Now();
+  auto due = last + delay;
+  if (failures && !prefs_->GetTime(kRetryAfter).is_null()) { due = prefs_->GetTime(kRetryAfter); }
+  if (!failures && prefs_->GetInteger(kOutcome) == static_cast<int>(FilterUpdateOutcome::kNone)) {
+    due = last + base::Hours(1);  // Resume an interrupted check without waiting a full day.
+  }
+  if (last.is_null() || due <= now || last > now + base::Days(1)) { CheckNow(); return; }
+  timer_.Start(FROM_HERE, due - now,
+      base::BindOnce(&SendaFilterUpdater::CheckNow, lifetime_.GetWeakPtr()));
+}
+std::string SendaFilterUpdater::MinimumVersion(size_t index) const {
+  auto floor = bundled_.versions[index];
+  if (const auto* accepted = prefs_->GetDict(kVersions).FindString(kFiles[index])) {
+    floor = std::max(floor, *accepted);
+  }
+  if (active_) { floor = std::max(floor, active_->sources[index].version); }
+  return floor;
+}
+void SendaFilterUpdater::CheckNow() {
+  if (!ready_) { manual_pending_ = true; return; }
+  if (status_.phase != FilterUpdatePhase::kIdle) { return; }
+  timer_.Stop();
+  operation_.InvalidateWeakPtrs();
+  status_.phase = FilterUpdatePhase::kDownloading;
+  status_.outcome = FilterUpdateOutcome::kNone;
+  status_.persistence_error = false;
+  status_.last_check = base::Time::Now();
+  prefs_->SetTime(kLastCheck, status_.last_check);
+  prefs_->SetInteger(kOutcome, static_cast<int>(FilterUpdateOutcome::kNone));
+  source_info_ = {};
+  source_hashes_ = {};
+  candidate_.reset(); prior_.reset(); staging_.clear();
+  Notify();
+  store_.AsyncCall(&SendaFilterStore::CreateStagingDirectory).Then(
+      base::BindOnce(&SendaFilterUpdater::Begin, operation_.GetWeakPtr()));
+}
+void SendaFilterUpdater::Begin(base::FilePath staging) {
+  if (staging.empty()) { Fail(); return; }
+  staging_ = std::move(staging);
+  Download(0, true);
+}
+void SendaFilterUpdater::Download(size_t index, bool conditional) {
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = GURL(kUrls[index]);
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->load_flags = net::LOAD_DISABLE_CACHE | net::LOAD_BYPASS_CACHE;
+  request->headers.SetHeader("Accept", "text/plain");
+  if (conditional && active_ && active_->sources[index].version >= MinimumVersion(index)) {
+    const auto& source = active_->sources[index];
+    if (!source.etag.empty()) { request->headers.SetHeader("If-None-Match", source.etag); }
+    if (!source.last_modified.empty()) { request->headers.SetHeader("If-Modified-Since", source.last_modified); }
+  }
+  constexpr auto annotation = net::DefineNetworkTrafficAnnotation("senda_protection_list_update", R"(
+    semantics {
+      sender: "Senda protection list updater"
+      description: "Downloads EasyList and EasyPrivacy to update native advertisement and tracker blocking."
+      trigger: "Daily while Senda is open with automatic updates enabled, or a user manual check."
+      data: "No account or browsing data. Conditional HTTP validators from the previous list response."
+      destination: WEBSITE
+      destination_other: "https://easylist.to/"
+    }
+    policy {
+      cookies_allowed: NO
+      setting: "Automatic protection list updates can be disabled in Senda's protection panel. Manual checks remain available."
+      policy_exception_justification: "No enterprise policy is implemented for this Senda-specific feature."
+    })");
+  loader_ = network::SimpleURLLoader::Create(std::move(request), annotation);
+  loader_->SetTimeoutDuration(base::Seconds(60));
+  loader_->SetAllowHttpErrorResults(true);
+  loader_->SetOnRedirectCallback(base::BindRepeating(
+      [](base::WeakPtr<SendaFilterUpdater> self, size_t index, const GURL&,
+         const net::RedirectInfo& redirect, const network::mojom::URLResponseHead&,
+         std::vector<std::string>*) {
+        if (self && redirect.new_url != GURL(kUrls[index])) { self->Fail(); }
+      }, operation_.GetWeakPtr(), index));
+  loader_->DownloadToFile(factory_.get(), base::BindOnce(&SendaFilterUpdater::OnDownloaded,
+      operation_.GetWeakPtr(), index, conditional),
+      staging_.AppendASCII(std::string(kFiles[index]) + ".download"), kSourceLimit);
+}
+void SendaFilterUpdater::OnDownloaded(size_t index, bool conditional, base::FilePath file) {
+  const auto* head = loader_->ResponseInfo();
+  const auto code = head && head->headers ? head->headers->response_code() : 0;
+  const auto net_error = loader_->NetError();
+  const auto mime = head ? head->mime_type : std::string();
+  if (head && head->headers) {
+    source_info_[index].etag = SingleValidator(*head->headers, "ETag");
+    source_info_[index].last_modified = SingleValidator(*head->headers, "Last-Modified");
+  }
+  loader_.reset();
+  if (code == 304 && conditional && active_ && active_->sources[index].version >= MinimumVersion(index)) {
+    auto& info = source_info_[index];
+    if (info.etag.empty()) { info.etag = active_->sources[index].etag; }
+    if (info.last_modified.empty()) { info.last_modified = active_->sources[index].last_modified; }
+    base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&CopyCachedSource, active_->directory.AppendASCII(kFiles[index]),
+            staging_.AppendASCII(kFiles[index]), active_->sources[index].sha256),
+        base::BindOnce(&SendaFilterUpdater::OnCachedCopied, operation_.GetWeakPtr(), index));
+  } else if (code == 304 && conditional) {
+    Download(index, false);
+  } else if (code == 200 && net_error == net::OK &&
+             (mime == "text/plain" || mime == "application/octet-stream") &&
+             file == staging_.AppendASCII(std::string(kFiles[index]) + ".download")) {
+    base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+        base::BindOnce(&base::Move, file, staging_.AppendASCII(kFiles[index])),
+        base::BindOnce(&SendaFilterUpdater::SourceReady, operation_.GetWeakPtr(), index));
+  } else { Fail(); }
+}
+void SendaFilterUpdater::OnCachedCopied(size_t index, bool success) {
+  if (!success) { Download(index, false); return; }
+  SourceReady(index, true);
+}
+void SendaFilterUpdater::SourceReady(size_t index, bool success) {
+  if (!success) { Fail(); return; }
+  if (index == 0) { Download(1, true); return; }
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&SendaFilterUpdater::HashSources, staging_),
+      base::BindOnce(&SendaFilterUpdater::OnHashes, operation_.GetWeakPtr()));
+}
+SendaFilterUpdater::SourceHashes SendaFilterUpdater::HashSources(base::FilePath directory) {
+  SourceHashes result;
+  for (size_t i = 0; i < 2; ++i) {
+    std::string text;
+    if (!base::ReadFileToStringWithMaxSize(directory.AppendASCII(kFiles[i]), &text, kSourceLimit) || text.size() < 1024) { return result; }
+    result.hashes[i] = Hash(text);
+  }
+  result.valid = true;
+  return result;
+}
+void SendaFilterUpdater::OnHashes(SourceHashes hashes) {
+  if (!hashes.valid) { Fail(); return; }
+  source_hashes_ = std::move(hashes);
+  if (active_ && source_hashes_.hashes[0] == active_->sources[0].sha256 &&
+      source_hashes_.hashes[1] == active_->sources[1].sha256) {
+    if (active_->sources[0].version < MinimumVersion(0) || active_->sources[1].version < MinimumVersion(1)) {
+      Fail(); return;
+    }
+    store_.AsyncCall(&SendaFilterStore::Recover).Then(
+        base::BindOnce(&SendaFilterUpdater::OnUnchangedCacheChecked, operation_.GetWeakPtr()));
+  } else { CompileCandidate(); }
+}
+void SendaFilterUpdater::OnUnchangedCacheChecked(RecoveryResult recovered) {
+  if (active_ && std::ranges::any_of(recovered.generations,
+      [this](const auto& generation) { return generation.id == active_->id; })) {
+    for (size_t i = 0; i < 2; ++i) {
+      active_->sources[i].etag = source_info_[i].etag;
+      active_->sources[i].last_modified = source_info_[i].last_modified;
+    }
+    Succeed(FilterUpdateOutcome::kUnchanged);
+  } else { CompileCandidate(); }
+}
+void SendaFilterUpdater::CompileCandidate() {
+  status_.phase = FilterUpdatePhase::kCompiling;
+  Notify();
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+      base::BindOnce(&SendaFilterUpdater::OpenCompilerFiles, staging_),
+      base::BindOnce(&SendaFilterUpdater::OnCompilerFiles, operation_.GetWeakPtr()));
+}
+SendaFilterUpdater::CompilerFiles SendaFilterUpdater::OpenCompilerFiles(base::FilePath directory) {
+  return {base::File(directory.AppendASCII(kFiles[0]), base::File::FLAG_OPEN | base::File::FLAG_READ),
+      base::File(directory.AppendASCII(kFiles[1]), base::File::FLAG_OPEN | base::File::FLAG_READ),
+      base::File(directory.AppendASCII("UnindexedRules"), base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE)};
+}
+void SendaFilterUpdater::OnCompilerFiles(CompilerFiles files) {
+  if (!files.first.IsValid() || !files.second.IsValid() || !files.output.IsValid()) { Fail(); return; }
+  compiler_timer_.Start(FROM_HERE, base::Seconds(60),
+      base::BindOnce(&SendaFilterUpdater::Fail, operation_.GetWeakPtr()));
+  compiler_.Run(std::move(files.first), std::move(files.second), std::move(files.output),
+      base::BindOnce(&SendaFilterUpdater::OnCompiled, operation_.GetWeakPtr()));
+}
+void SendaFilterUpdater::CancelCompiler() {
+  compiler_timer_.Stop();
+  if (!cancel_compiler_.is_null()) { cancel_compiler_.Run(); }
+}
+void SendaFilterUpdater::OnCompiled(CompileResult result) {
+  compiler_timer_.Stop();
+  if (result.status != CompileStatus::kSuccess || result.source_hashes != source_hashes_.hashes ||
+      result.network_rules < 1000) { Fail(); return; }
+  for (size_t i = 0; i < 2; ++i) {
+    if (result.versions[i] < MinimumVersion(i)) { Fail(); return; }
+    source_info_[i].version = result.versions[i]; source_info_[i].sha256 = result.source_hashes[i];
+  }
+  GenerationManifest manifest;
+  manifest.sources = source_info_;
+  manifest.ruleset_sha256 = result.ruleset_sha256;
+  manifest.license_sha256 = Hash(bundled_.license);
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE, {base::MayBlock()},
+      base::BindOnce([](base::FilePath directory, std::string license, GenerationManifest manifest)
+          -> std::optional<GenerationManifest> {
+        if (!WriteLicense(directory, std::move(license))) { return std::nullopt; }
+        const auto size = base::GetFileSize(directory.AppendASCII("UnindexedRules"));
+        if (!size || *size < 1024 || static_cast<uint64_t>(*size) > kSourceLimit) { return std::nullopt; }
+        manifest.ruleset_bytes = *size;
+        return manifest;
+      }, staging_, bundled_.license, std::move(manifest)),
+      base::BindOnce([](base::WeakPtr<SendaFilterUpdater> self, std::optional<GenerationManifest> manifest) {
+        if (!self) { return; }
+        if (!manifest) { self->Fail(); return; }
+        self->store_.AsyncCall(&SendaFilterStore::Stage).WithArgs(std::move(*manifest), self->staging_)
+            .Then(base::BindOnce(&SendaFilterUpdater::OnStaged, self));
+      }, operation_.GetWeakPtr()));
+}
+void SendaFilterUpdater::OnStaged(StageResult result) {
+  if (!result.generation) { Fail(); return; }
+  candidate_ = std::move(result.generation);
+  prior_ = active_;
+  status_.phase = FilterUpdatePhase::kPublishing;
+  Notify();
+  publisher_.Run(candidate_, base::BindOnce(&SendaFilterUpdater::OnPublished,
+      operation_.GetWeakPtr(), candidate_->id));
+}
+void SendaFilterUpdater::OnPublished(std::string expected, std::string actual, bool success) {
+  if (!success || actual != expected) { Fail(); return; }
+  active_ = candidate_;
+  status_.versions = {active_->sources[0].version, active_->sources[1].version};
+  status_.generation_id = active_->id;
+  store_.AsyncCall(&SendaFilterStore::CommitActive).WithArgs(active_->id).Then(
+      base::BindOnce(&SendaFilterUpdater::OnCommitted, operation_.GetWeakPtr()));
+}
+void SendaFilterUpdater::OnCommitted(bool success) {
+  if (success) { Succeed(FilterUpdateOutcome::kUpdated); return; }
+  status_.persistence_error = true;
+  publisher_.Run(prior_, base::BindOnce(&SendaFilterUpdater::OnRolledBack, operation_.GetWeakPtr()));
+}
+void SendaFilterUpdater::OnRolledBack(std::string actual, bool success) {
+  if (success && actual == (prior_ ? prior_->id : std::string())) {
+    active_ = prior_;
+    status_.versions = active_ ? std::array{active_->sources[0].version, active_->sources[1].version} : bundled_.versions;
+    status_.generation_id = active_ ? active_->id : std::string();
+    status_.persistence_error = false;
+  }
+  Fail();
+}
+void SendaFilterUpdater::SaveValidators() {
+  if (!active_) { return; }
+  base::DictValue validators;
+  auto versions = prefs_->GetDict(kVersions).Clone();
+  for (size_t i = 0; i < 2; ++i) {
+    const auto& source = active_->sources[i];
+    base::DictValue info;
+    info.Set("sha256", source.sha256); info.Set("etag", source.etag); info.Set("last_modified", source.last_modified);
+    validators.Set(kFiles[i], std::move(info));
+    const auto* floor = versions.FindString(kFiles[i]);
+    if (!floor || *floor < source.version) { versions.Set(kFiles[i], source.version); }
+  }
+  prefs_->SetDict(kValidators, std::move(validators));
+  prefs_->SetDict(kVersions, std::move(versions));
+}
+void SendaFilterUpdater::LoadValidators() {
+  if (!active_) { return; }
+  const auto& validators = prefs_->GetDict(kValidators);
+  for (size_t i = 0; i < 2; ++i) {
+    const auto* info = validators.FindDict(kFiles[i]);
+    if (!info) { continue; }
+    const auto* hash = info->FindString("sha256");
+    if (!hash || *hash != active_->sources[i].sha256) { continue; }
+    if (const auto* etag = info->FindString("etag")) { active_->sources[i].etag = HttpValidator(*etag); }
+    if (const auto* modified = info->FindString("last_modified")) { active_->sources[i].last_modified = HttpValidator(*modified); }
+  }
+}
+void SendaFilterUpdater::Succeed(FilterUpdateOutcome outcome) {
+  SaveValidators();
+  prefs_->SetInteger(kFailures, 0);
+  prefs_->SetTime(kRetryAfter, base::Time());
+  prefs_->SetInteger(kOutcome, static_cast<int>(outcome));
+  status_.outcome = outcome;
+  status_.phase = FilterUpdatePhase::kIdle;
+  operation_.InvalidateWeakPtrs();
+  if (!staging_.empty()) { store_.AsyncCall(base::IgnoreResult(&SendaFilterStore::DiscardStaging)).WithArgs(staging_); }
+  store_.AsyncCall(&SendaFilterStore::Prune);
+  Notify(); Schedule();
+}
+void SendaFilterUpdater::Fail() {
+  operation_.InvalidateWeakPtrs();
+  loader_.reset(); CancelCompiler();
+  status_.outcome = FilterUpdateOutcome::kError;
+  status_.phase = FilterUpdatePhase::kIdle;
+  const auto failures = std::clamp(prefs_->GetInteger(kFailures), 0, 2) + 1;
+  prefs_->SetInteger(kFailures, failures);
+  prefs_->SetTime(kRetryAfter, base::Time::Now() +
+      (failures == 1 ? base::Hours(1) : failures == 2 ? base::Hours(6) : base::Days(1)));
+  prefs_->SetInteger(kOutcome, static_cast<int>(FilterUpdateOutcome::kError));
+  if (!staging_.empty()) { store_.AsyncCall(base::IgnoreResult(&SendaFilterStore::DiscardStaging)).WithArgs(staging_); }
+  Notify(); Schedule();
+}
+}  // namespace subresource_filter
