@@ -0,0 +1,37 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#ifndef CHROME_BROWSER_SUBRESOURCE_FILTER_SENDA_FILTER_COMPILER_PROCESS_H_
+#define CHROME_BROWSER_SUBRESOURCE_FILTER_SENDA_FILTER_COMPILER_PROCESS_H_
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/process/process.h"
+#include <optional>
+#include "components/subresource_filter/content/mojom/senda_filter_compiler.mojom.h"
+#include "components/subresource_filter/tools/rule_parser/senda_filter_compiler.h"
+#include "mojo/public/cpp/bindings/remote.h"
+namespace subresource_filter {
+// UI-sequence adapter. Owns only the utility process launched for this job.
+class SendaFilterCompilerProcess {
+ public:
+  using Completion = base::OnceCallback<void(CompileResult)>;
+  SendaFilterCompilerProcess();
+  ~SendaFilterCompilerProcess();
+  void Compile(base::File first, base::File second, base::File output, Completion done);
+  void Cancel();
+ private:
+  void OnLaunched(uint64_t job, const base::Process& process);
+  void OnReply(senda::mojom::FilterCompileResultPtr reply);
+  void OnDisconnected();
+  void StopCompletedWorker();
+  void OnStopped(Completion done, CompileResult result, bool stopped);
+  Completion pending_;
+  mojo::Remote<senda::mojom::FilterCompiler> remote_;
+  base::Process process_;
+  std::optional<CompileResult> received_;
+  uint64_t job_ = 0;
+  bool canceled_ = true;
+  base::WeakPtrFactory<SendaFilterCompilerProcess> lifetime_{this};
+  base::WeakPtrFactory<SendaFilterCompilerProcess> weak_{this};
+};
+}  // namespace subresource_filter
+#endif
diff --git a/chrome/browser/subresource_filter/senda_filter_compiler_process.cc b/chrome/browser/subresource_filter/senda_filter_compiler_process.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/subresource_filter/senda_filter_compiler_process.cc
@@ -0,0 +1,94 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/subresource_filter/senda_filter_compiler_process.h"
+#include <utility>
+#include "base/functional/bind.h"
+#include "base/task/thread_pool.h"
+#include "content/public/browser/service_process_host.h"
+namespace subresource_filter {
+namespace {
+bool StopWorker(base::Process process) {
+  int exit_code = 0;
+  if (process.WaitForExitWithTimeout(base::TimeDelta(), &exit_code)) { return true; }
+  process.Terminate(0, false);
+  return process.WaitForExitWithTimeout(base::Seconds(5), &exit_code);
+}
+}  // namespace
+SendaFilterCompilerProcess::SendaFilterCompilerProcess() = default;
+SendaFilterCompilerProcess::~SendaFilterCompilerProcess() { Cancel(); }
+void SendaFilterCompilerProcess::Compile(base::File first, base::File second,
+                                         base::File output, Completion done) {
+  Cancel();
+  canceled_ = false;
+  pending_ = std::move(done);
+  remote_ = content::ServiceProcessHost::Launch<senda::mojom::FilterCompiler>(
+      content::ServiceProcessHost::Options().WithDisplayName(u"Listas de protecciÃ³n de Senda")
+          .WithProcessCallback(base::BindOnce(
+              [](base::WeakPtr<SendaFilterCompilerProcess> self, uint64_t job,
+                 const base::Process& process) {
+                if (self) { self->OnLaunched(job, process); }
+                else { process.Duplicate().Terminate(1, false); }
+              }, lifetime_.GetWeakPtr(), job_)).Pass());
+  remote_.set_disconnect_handler(base::BindOnce(&SendaFilterCompilerProcess::OnDisconnected, weak_.GetWeakPtr()));
+  remote_->Compile(std::move(first), std::move(second), std::move(output),
+      base::BindOnce(&SendaFilterCompilerProcess::OnReply, weak_.GetWeakPtr()));
+}
+void SendaFilterCompilerProcess::OnLaunched(uint64_t job, const base::Process& process) {
+  if (job != job_ || canceled_) { process.Duplicate().Terminate(1, false); return; }
+  process_ = process.Duplicate();
+  if (received_) { StopCompletedWorker(); }
+}
+void SendaFilterCompilerProcess::OnDisconnected() {
+  if (received_) { return; }
+  auto done = std::move(pending_);
+  Cancel();
+  if (done) { std::move(done).Run(CompileResult()); }
+}
+void SendaFilterCompilerProcess::OnReply(senda::mojom::FilterCompileResultPtr reply) {
+  CompileResult result;
+  if (reply && reply->versions.size() == 2 && reply->source_hashes.size() == 2) {
+    switch (reply->status) {
+      case senda::mojom::FilterCompileStatus::kSuccess: result.status = CompileStatus::kSuccess; break;
+      case senda::mojom::FilterCompileStatus::kInvalidSource: result.status = CompileStatus::kInvalidSource; break;
+      case senda::mojom::FilterCompileStatus::kLimitExceeded: result.status = CompileStatus::kLimitExceeded; break;
+      case senda::mojom::FilterCompileStatus::kWriteFailure: result.status = CompileStatus::kWriteFailure; break;
+    }
+    for (size_t i = 0; i < 2; ++i) {
+      result.versions[i] = reply->versions[i]; result.source_hashes[i] = reply->source_hashes[i];
+    }
+    result.ruleset_sha256 = reply->ruleset_sha256;
+    result.network_rules = reply->network_rules;
+    result.cosmetic_rules = reply->cosmetic_rules;
+  }
+  received_ = std::move(result);
+  remote_.reset();
+  if (process_.IsValid()) { StopCompletedWorker(); }
+}
+void SendaFilterCompilerProcess::StopCompletedWorker() {
+  auto done = std::move(pending_);
+  auto result = std::move(*received_);
+  received_.reset();
+  canceled_ = true;
+  weak_.InvalidateWeakPtrs();
+  // A utility reply alone does not revoke its writable output handle. Stop
+  // our dedicated worker before the parent validates/indexes that file.
+  base::ThreadPool::PostTaskAndReplyWithResult(FROM_HERE,
+      {base::MayBlock(), base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(&StopWorker, std::move(process_)),
+      base::BindOnce(&SendaFilterCompilerProcess::OnStopped, weak_.GetWeakPtr(),
+          std::move(done), std::move(result)));
+}
+void SendaFilterCompilerProcess::OnStopped(Completion done, CompileResult result, bool stopped) {
+  if (!stopped) { result.status = CompileStatus::kWriteFailure; }
+  if (done) { std::move(done).Run(std::move(result)); }
+}
+void SendaFilterCompilerProcess::Cancel() {
+  ++job_;
+  canceled_ = true;
+  received_.reset();
+  weak_.InvalidateWeakPtrs();
+  pending_.Reset();
+  remote_.reset();
+  if (process_.IsValid()) { process_.Terminate(1, false); process_.Close(); }
+}
+}  // namespace subresource_filter
