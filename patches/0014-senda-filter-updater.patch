+    SendaFilterUpdater::RegisterLocalStatePrefs(prefs_.registry());
+    CreateUpdater();
+  }
+  void CreateUpdater() {
+    BundledFilterSnapshot bundled;
+    bundled.versions = {"202611160028", "202611160028"};
+    bundled.content_version = "senda-bundle";
+    bundled.license = "The EasyList authors CC-BY-SA-3.0";
+    updater_ = std::make_unique<SendaFilterUpdater>(
+        &prefs_, directory_.GetPath(), factory_.GetSafeWeakWrapper(), std::move(bundled),
+        base::BindRepeating(&SendaUpdaterTest::Publish, base::Unretained(this)),
+        base::BindRepeating(&SendaUpdaterTest::Compile, base::Unretained(this)),
+        base::RepeatingClosure(), writer_);
+    updater_->Start();
+    tasks_.RunUntilIdle();
+    publications_.clear();
+  }
+  void TearDown() override { updater_.reset(); tasks_.RunUntilIdle(); }
+  void Response(size_t index, std::string text, int code = 200) {
+    auto head = network::mojom::URLResponseHead::New();
+    head->mime_type = "text/plain";
+    head->headers = net::HttpResponseHeaders::TryToCreate(
+        "HTTP/1.1 " + std::to_string(code) + " Fixture\r\nContent-Type: text/plain\r\nETag: \"fixture\"\r\n\r\n");
+    factory_.AddResponse(GURL(kUrls[index]), std::move(head), text,
+                         network::URLLoaderCompletionStatus(net::OK));
+  }
+  void Compile(base::File first, base::File second, base::File output,
+               SendaFilterUpdater::CompileCompletion done) {
+    ++compiles_;
+    std::move(done).Run(CompileSendaFilters(std::move(first), std::move(second), std::move(output)));
+  }
+  void Publish(const std::optional<GenerationManifest>& manifest,
+               SendaFilterUpdater::PublishCompletion done) {
+    const auto id = manifest ? manifest->id : std::string();
+    publications_.push_back(id);
+    std::move(done).Run(wrong_ack_ ? "wrong-generation" : id, !fail_publish_);
+  }
+  void Check() { updater_->CheckNow(); tasks_.RunUntilIdle(); }
+  void Restart() { updater_.reset(); tasks_.RunUntilIdle(); CreateUpdater(); }
+  void RespondOnSecondFirstSourceRequest(const network::ResourceRequest& request) {
+    if (request.url == GURL(kUrls[0]) && ++first_requests_ == 2) { Response(0, List(0)); }
+  }
+  void RefetchOnSecondRequest() {
+    factory_.SetInterceptor(base::BindRepeating(
+        &SendaUpdaterTest::RespondOnSecondFirstSourceRequest, base::Unretained(this)));
+  }
+  base::test::TaskEnvironment tasks_{base::test::TaskEnvironment::TimeSource::MOCK_TIME};
+  base::ScopedTempDir directory_;
+  TestingPrefServiceSimple prefs_;
+  network::TestURLLoaderFactory factory_;
+  SendaFilterStore::AtomicWriter writer_;
+  std::unique_ptr<SendaFilterUpdater> updater_;
+  int compiles_ = 0;
+  bool fail_publish_ = false, wrong_ack_ = false;
+  size_t first_requests_ = 0;
+  std::vector<std::string> publications_;
+};
