+}
+TEST_F(SendaUpdaterTest, ManualWorksWithAutomaticOffAndCoalescesRequests) {
+  updater_->SetAutomaticUpdates(false);
+  tasks_.FastForwardBy(base::Days(2));
+  EXPECT_EQ(0, factory_.NumPending());
+  updater_->CheckNow(); updater_->CheckNow();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(1, factory_.NumPending());
+  Response(0, List(0)); Response(1, List(1));
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(1, compiles_);
+  EXPECT_FALSE(updater_->GetStatus().automatic);
+}
