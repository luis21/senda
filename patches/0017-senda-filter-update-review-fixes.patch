+// Blocking sequence only. Retains both selected indices and indexing sentinels;
+// Windows sharing violations are retried on the next successful check.
+void PruneSendaIndexedRulesets(const base::FilePath& root,
+                              const base::FilePath& current,
+                              const base::FilePath& previous);
