+TEST_F(SendaUpdaterTest, ResumeReevaluatesExpiredWallClockDeadlineOnlyOnce) {
+  Response(0, List(0)); Response(1, List(1)); Check();
+  factory_.ClearResponses();
+  power_.Suspend();
+  // Expire the persisted wall-clock deadline without advancing the armed
+  // relative timer, modeling time spent asleep on platforms with frozen ticks.
+  prefs_.SetTime("senda.filter_updates.last_check", base::Time::Now() - base::Days(2));
+  power_.Resume();
+  tasks_.RunUntilIdle();
+  EXPECT_EQ(1, factory_.NumPending());
+  power_.Suspend(); power_.Resume(); tasks_.RunUntilIdle();
+  EXPECT_EQ(1, factory_.NumPending());
+}
 
