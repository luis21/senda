+namespace subresource_filter {
+TEST(SendaIndexCleanupTest, PreservesCurrentPreviousSentinelAndRetriesLockedFiles) {
+  base::ScopedTempDir temp;
+  ASSERT_TRUE(temp.CreateUniqueTempDir());
+  const auto root = temp.GetPath().AppendASCII("index");
+  const auto current = root.AppendASCII("39/current");
+  const auto previous = root.AppendASCII("39/previous");
+  const auto obsolete = root.AppendASCII("39/obsolete");
+  const auto busy = root.AppendASCII("39/busy");
+  const auto sentinel = root.AppendASCII("39/sentinel");
+  const auto old_format = root.AppendASCII("38/old");
+  for (const auto& path : {current, previous, obsolete, busy, sentinel, old_format}) {
+    ASSERT_TRUE(base::CreateDirectory(path));
+    ASSERT_TRUE(base::WriteFile(path.AppendASCII("Ruleset Data"), "fixture"));
+  }
+  ASSERT_TRUE(base::WriteFile(sentinel.Append(kSentinelFileName), ""));
+  base::File locked(busy.AppendASCII("Ruleset Data"), base::File::FLAG_OPEN | base::File::FLAG_READ);
+  ASSERT_TRUE(locked.IsValid());
+  PruneSendaIndexedRulesets(root, current, previous);
+  EXPECT_TRUE(base::DirectoryExists(current));
+  EXPECT_TRUE(base::DirectoryExists(previous));
+  EXPECT_TRUE(base::DirectoryExists(sentinel));
+  EXPECT_FALSE(base::PathExists(obsolete));
+  EXPECT_FALSE(base::PathExists(old_format));
+  EXPECT_TRUE(base::PathExists(busy));
+  locked.Close();
+  PruneSendaIndexedRulesets(root, current, previous);
+  EXPECT_FALSE(base::PathExists(busy));
+}
