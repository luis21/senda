+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "components/subresource_filter/core/browser/senda_index_cleanup.h"
+#include "base/files/file_enumerator.h"
+#include "base/files/file_util.h"
+#include "components/subresource_filter/core/browser/subresource_filter_constants.h"
+namespace subresource_filter {
+void PruneSendaIndexedRulesets(const base::FilePath& root_arg,
+                              const base::FilePath& current_arg,
+                              const base::FilePath& previous_arg) {
+  const auto root = root_arg.NormalizePathSeparators();
+  const auto current = current_arg.NormalizePathSeparators();
+  const auto previous = previous_arg.NormalizePathSeparators();
+  const auto owned = [&root](const base::FilePath& path) {
+    return path.IsAbsolute() && !path.ReferencesParent() &&
+        path.DirName().DirName() == root;
+  };
+  if (!root.IsAbsolute() || root.ReferencesParent() || !owned(current) ||
+      (!previous.empty() && !owned(previous))) { return; }
+  base::FileEnumerator formats(root, false, base::FileEnumerator::DIRECTORIES);
+  for (auto format = formats.Next(); !format.empty(); format = formats.Next()) {
+    if (format != current.DirName() && (previous.empty() || format != previous.DirName())) {
+      base::DeletePathRecursively(format);
+      continue;
+    }
+    base::FileEnumerator versions(format, false, base::FileEnumerator::DIRECTORIES);
+    for (auto version = versions.Next(); !version.empty(); version = versions.Next()) {
+      if (version != current && version != previous &&
+          !base::PathExists(version.Append(kSentinelFileName))) {
+        base::DeletePathRecursively(version);
+      }
+    }
+  }
+}
+}
