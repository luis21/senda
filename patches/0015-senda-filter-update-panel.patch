+std::unique_ptr<views::View> ContentSettingBubbleContents::CreateSendaListControls() {
+  senda_updater_ = g_browser_process->senda_filter_updater()->GetWeakPtr();
+  auto column = std::make_unique<views::BoxLayoutView>();
+  column->SetOrientation(views::BoxLayout::Orientation::kVertical);
+  column->SetCrossAxisAlignment(views::BoxLayout::CrossAxisAlignment::kStretch);
+  column->SetBetweenChildSpacing(8);
+  auto label = [&](std::u16string text, bool heading = false) {
+    auto view = std::make_unique<views::Label>(text, views::style::CONTEXT_LABEL,
+        heading ? views::style::STYLE_BODY_3_EMPHASIS : views::style::STYLE_BODY_3);
+    view->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    view->SetMultiLine(true);
+    return column->AddChildView(std::move(view));
+  };
+  label(u"Listas de protección", true);
+  label(u"Para todos los perfiles. Las listas nuevas se aplican al abrir o recargar una página.");
+  senda_automatic_ = column->AddChildView(std::make_unique<views::Checkbox>(
+      u"Actualizar listas automáticamente", base::BindRepeating(
+          &ContentSettingBubbleContents::OnSendaAutomaticChanged, weak_factory_.GetWeakPtr())));
+  senda_automatic_->SetMultiLine(true);
+  senda_versions_ = label(u"");
+  senda_last_check_ = label(u"");
+  senda_result_ = label(u"");
+  senda_check_ = column->AddChildView(std::make_unique<views::MdTextButton>(
+      base::BindRepeating(&ContentSettingBubbleContents::OnSendaCheckNow,
+          weak_factory_.GetWeakPtr()), u"Buscar actualizaciones"));
+  senda_check_->SetStyle(ui::ButtonStyle::kTonal);
+  senda_updates_subscription_ = senda_updater_->Observe(base::BindRepeating(
+      &ContentSettingBubbleContents::RefreshSendaLists, weak_factory_.GetWeakPtr()));
+  RefreshSendaLists();
+  return column;
+}
+void ContentSettingBubbleContents::OnSendaAutomaticChanged() {
+  if (senda_updater_) { senda_updater_->SetAutomaticUpdates(senda_automatic_->GetChecked()); }
+}
+void ContentSettingBubbleContents::OnSendaCheckNow() {
+  if (senda_updater_) { senda_updater_->CheckNow(); }
+}
+void ContentSettingBubbleContents::RefreshSendaLists() {
+  if (!senda_updater_ || !senda_automatic_) { return; }
+  const auto status = senda_updater_->GetStatus();
+  senda_automatic_->SetChecked(status.automatic);
+  const bool busy = status.phase != subresource_filter::FilterUpdatePhase::kIdle;
+  senda_check_->SetEnabled(!busy);
+  auto version = [](std::string_view code) -> std::u16string {
+    if (code.size() != 12) { return u"No disponible"; }
+    return base::UTF8ToUTF16(std::string(code.substr(0, 4)) + "-" +
+        std::string(code.substr(4, 2)) + "-" + std::string(code.substr(6, 2)) +
+        " " + std::string(code.substr(8, 2)) + ":" + std::string(code.substr(10, 2)) + " UTC");
+  };
+  senda_versions_->SetText(u"EasyList: " + version(status.versions[0]) +
+                           u"\nEasyPrivacy: " + version(status.versions[1]));
+  senda_last_check_->SetText(status.last_check.is_null() ? u"Sin comprobaciones todavía" :
+      u"Última comprobación: " + base::TimeFormatShortDateAndTime(status.last_check));
+  std::u16string result;
+  if (status.phase == subresource_filter::FilterUpdatePhase::kLoading) {
+    result = u"Preparando listas…";
+  } else if (busy) {
+    result = u"Comprobando listas…";
+  } else {
+    switch (status.outcome) {
+      case subresource_filter::FilterUpdateOutcome::kNone:
+        result = u"Las listas incluidas protegen sin conexión."; break;
+      case subresource_filter::FilterUpdateOutcome::kUnchanged:
+        result = u"Las listas ya están actualizadas."; break;
+      case subresource_filter::FilterUpdateOutcome::kUpdated:
+        result = u"Listas actualizadas."; break;
+      case subresource_filter::FilterUpdateOutcome::kError:
+        result = status.persistence_error ?
+            u"Las listas activas no pudieron guardarse. Se reintentará la actualización." :
+            u"No se pudo actualizar. Se conserva la versión anterior."; break;
+    }
+  }
+  senda_result_->SetText(result);
+  PreferredSizeChanged();
+  if (GetWidget() && !GetWidget()->IsClosed()) { SizeToContents(); }
 }
 
