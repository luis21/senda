diff --git a/chrome/browser/subresource_filter/senda_filter_update_message.cc b/chrome/browser/subresource_filter/senda_filter_update_message.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/subresource_filter/senda_filter_update_message.cc
@@ -0,0 +1,27 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/subresource_filter/senda_filter_update_message.h"
+#include "chrome/browser/subresource_filter/senda_filter_updater.h"
+namespace subresource_filter {
+std::u16string GetSendaFilterUpdateMessage(const FilterUpdateStatus& status,
+                                         bool protection_ready) {
+  if (status.phase == FilterUpdatePhase::kLoading) { return u"Preparando listas…"; }
+  if (status.phase != FilterUpdatePhase::kIdle) { return u"Comprobando listas…"; }
+  if (!protection_ready) {
+    return u"No se pudo preparar la protección. Pulsa Buscar actualizaciones para reintentar.";
+  }
+  switch (status.outcome) {
+    case FilterUpdateOutcome::kNone:
+      return u"Las listas incluidas protegen sin conexión.";
+    case FilterUpdateOutcome::kUnchanged:
+      return u"Las listas ya están actualizadas.";
+    case FilterUpdateOutcome::kUpdated:
+      return u"Listas actualizadas.";
+    case FilterUpdateOutcome::kError:
+      return status.persistence_error ?
+          u"Las listas activas no pudieron guardarse. Se reintentará la actualización." :
+          u"No se pudo actualizar. Se conserva la versión anterior.";
+  }
+  return u"Estado no disponible.";
+}
+}
diff --git a/chrome/browser/subresource_filter/senda_filter_update_message_unittest.cc b/chrome/browser/subresource_filter/senda_filter_update_message_unittest.cc
new file mode 100644
--- /dev/null
+++ b/chrome/browser/subresource_filter/senda_filter_update_message_unittest.cc
@@ -0,0 +1,46 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "chrome/browser/subresource_filter/senda_filter_update_message.h"
+#include "chrome/browser/subresource_filter/senda_filter_updater.h"
+#include "testing/gtest/include/gtest/gtest.h"
+namespace subresource_filter {
+TEST(SendaPanelMessageTest, UnavailableProtectionNeverPromisesAnActiveGeneration) {
+  FilterUpdateStatus status;
+  status.phase = FilterUpdatePhase::kIdle;
+  for (auto outcome : {FilterUpdateOutcome::kNone, FilterUpdateOutcome::kUnchanged,
+                        FilterUpdateOutcome::kUpdated, FilterUpdateOutcome::kError}) {
+    status.outcome = outcome;
+    EXPECT_EQ(u"No se pudo preparar la protección. Pulsa Buscar actualizaciones para reintentar.",
+              GetSendaFilterUpdateMessage(status, false));
+  }
+}
+TEST(SendaPanelMessageTest, KeepsPreviousAndUnsavedGenerationsDistinct) {
+  FilterUpdateStatus status;
+  status.phase = FilterUpdatePhase::kIdle;
+  status.outcome = FilterUpdateOutcome::kError;
+  EXPECT_EQ(u"No se pudo actualizar. Se conserva la versión anterior.",
+            GetSendaFilterUpdateMessage(status, true));
+  status.persistence_error = true;
+  EXPECT_EQ(u"Las listas activas no pudieron guardarse. Se reintentará la actualización.",
+            GetSendaFilterUpdateMessage(status, true));
+}
+TEST(SendaPanelMessageTest, PreparingAndWorkingDoNotReportSuccess) {
+  FilterUpdateStatus status;
+  status.outcome = FilterUpdateOutcome::kUpdated;
+  EXPECT_EQ(u"Preparando listas…", GetSendaFilterUpdateMessage(status, false));
+  for (auto phase : {FilterUpdatePhase::kDownloading, FilterUpdatePhase::kCompiling,
+                      FilterUpdatePhase::kPublishing}) {
+    status.phase = phase;
+    EXPECT_EQ(u"Comprobando listas…", GetSendaFilterUpdateMessage(status, true));
+  }
+}
+TEST(SendaPanelMessageTest, BundledUnchangedAndUpdatedResultsAreDistinct) {
+  FilterUpdateStatus status;
+  status.phase = FilterUpdatePhase::kIdle;
+  EXPECT_EQ(u"Las listas incluidas protegen sin conexión.", GetSendaFilterUpdateMessage(status, true));
+  status.outcome = FilterUpdateOutcome::kUnchanged;
+  EXPECT_EQ(u"Las listas ya están actualizadas.", GetSendaFilterUpdateMessage(status, true));
+  status.outcome = FilterUpdateOutcome::kUpdated;
+  EXPECT_EQ(u"Listas actualizadas.", GetSendaFilterUpdateMessage(status, true));
+}
+}
