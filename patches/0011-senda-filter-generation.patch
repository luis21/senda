+void RulesetIndexer::SetCosmeticExceptions(
+    const proto::CosmeticExceptions& exceptions) {
+  auto strings = [this](const auto& values) {
+    std::vector<flatbuffers::Offset<flatbuffers::String>> offsets;
+    offsets.reserve(values.size());
+    for (const auto& value : values) {
+      offsets.push_back(builder_.CreateString(value));
+    }
+    return builder_.CreateVector(offsets);
+  };
+  const auto generic_domains = strings(exceptions.generic_domains());
+  const auto all_domains = strings(exceptions.all_domains());
+  const auto generic_prefixes = strings(exceptions.generic_prefixes());
+  const auto all_prefixes = strings(exceptions.all_prefixes());
+  const auto generic_fragments = strings(exceptions.generic_url_substrings());
+  const auto all_fragments = strings(exceptions.all_url_substrings());
+  cosmetic_exceptions_ = flat::CreateCosmeticExceptions(
+      builder_, generic_domains, all_domains, generic_prefixes, all_prefixes,
+      generic_fragments, all_fragments, exceptions.disable_all_generic(),
+      exceptions.disable_all_cosmetic());
+}
