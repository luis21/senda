+
+namespace subresource_filter {
+namespace {
+namespace proto = url_pattern_index::proto;
+
+TEST(SendaGenerationTest, DevelopmentPackagerWireFormatMatchesNativeReader) {
+  const std::string bytes = "\x0d\x1a\x0b\x0a\x09keep.test";
+  google::protobuf::io::ArrayInputStream input(bytes.data(), bytes.size());
+  UnindexedRulesetReader reader(&input);
+  proto::FilteringRules chunk;
+  ASSERT_TRUE(reader.ReadNextChunk(&chunk));
+  ASSERT_TRUE(chunk.has_cosmetic_exceptions());
+  ASSERT_EQ(1, chunk.cosmetic_exceptions().generic_domains_size());
+  EXPECT_EQ("keep.test", chunk.cosmetic_exceptions().generic_domains(0));
+}
+
+TEST(SendaGenerationTest, ExceptionOnlyChunkSurvivesSerialization) {
+  proto::CosmeticExceptions exceptions;
+  exceptions.add_generic_domains("keep.test");
+  exceptions.add_all_domains("all.test");
+  exceptions.add_generic_prefixes("www.google.");
+  exceptions.add_all_prefixes("music.amazon.");
+  exceptions.add_generic_url_substrings("://localhost:");
+  exceptions.add_all_url_substrings("://192.168.");
+  exceptions.set_disable_all_generic(true);
+  exceptions.set_disable_all_cosmetic(true);
+  std::string bytes;
+  {
+    google::protobuf::io::StringOutputStream output(&bytes);
+    UnindexedRulesetWriter writer(&output);
+    EXPECT_TRUE(writer.SetCosmeticExceptions(exceptions));
+    EXPECT_TRUE(writer.Finish());
+  }
+  google::protobuf::io::ArrayInputStream input(bytes.data(), bytes.size());
+  UnindexedRulesetReader reader(&input);
+  proto::FilteringRules chunk;
+  ASSERT_TRUE(reader.ReadNextChunk(&chunk));
+  EXPECT_EQ(exceptions.SerializeAsString(),
+            chunk.cosmetic_exceptions().SerializeAsString());
+  EXPECT_FALSE(reader.ReadNextChunk(&chunk));
+}
+
+TEST(SendaGenerationTest, DocumentKeepsItsOwnExceptions) {
+  proto::CosmeticExceptions exceptions;
+  exceptions.add_generic_domains("keep.test");
+  exceptions.add_all_domains("all.test");
+  exceptions.add_generic_prefixes("www.google.");
+  exceptions.add_generic_url_substrings("://localhost:");
+  RulesetIndexer old_generation(1), new_generation(2);
+  old_generation.SetCosmeticExceptions(exceptions);
+  old_generation.Finish();
+  exceptions.set_disable_all_cosmetic(true);
+  new_generation.SetCosmeticExceptions(exceptions);
+  new_generation.Finish();
+  IndexedRulesetMatcher old_rules(old_generation.data());
+  IndexedRulesetMatcher new_rules(new_generation.data());
+  auto evaluate = [&](const char* url) {
+    return old_rules.GetCosmeticActivation(GURL(url), GURL(url));
+  };
+  EXPECT_TRUE(evaluate("https://sub.keep.test/").disable_generic);
+  EXPECT_FALSE(evaluate("https://notkeep.test/").disable_generic);
+  EXPECT_TRUE(evaluate("https://all.test/").disable_all);
+  EXPECT_TRUE(evaluate("https://www.google.co.uk/search").disable_generic);
+  EXPECT_TRUE(evaluate("https://page.test/path/://localhost:123/").disable_generic);
+  EXPECT_FALSE(evaluate("https://ordinary.test/").disable_all);
+  EXPECT_TRUE(new_rules.GetCosmeticActivation(
+      GURL("https://ordinary.test/"), GURL()).disable_all);
+  EXPECT_TRUE(old_rules.GetCosmeticActivation(
+      GURL("about:blank"), GURL("https://all.test/")).disable_all);
+}
+
+TEST(SendaGenerationTest, LegacyMissingMetadataDoesNotHideContent) {
+  RulesetIndexer indexer(1);
+  indexer.Finish();
+  IndexedRulesetMatcher rules(indexer.data());
+  EXPECT_TRUE(rules.GetCosmeticActivation(GURL("https://test/"), GURL()).disable_all);
+}
