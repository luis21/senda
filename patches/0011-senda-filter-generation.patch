+CosmeticActivation IndexedRulesetMatcher::GetCosmeticActivation(
+    const GURL& document_url,
+    const GURL& origin_url) const {
+  const auto* exceptions = root_->cosmetic_exceptions();
+  if (!exceptions) {
+    // Legacy resources have no activation metadata: prefer underblocking.
+    return {.disable_generic = true, .disable_all = true};
+  }
+  const std::string_view host = origin_url.host();
+  const auto matches = [&](const auto* domains, const auto* prefixes,
+                           const auto* fragments) {
+    if (domains) {
+      for (const auto* entry : *domains) {
+        const std::string_view domain = entry->string_view();
+        if (host == domain ||
+            (host.size() > domain.size() && host.ends_with(domain) &&
+             host[host.size() - domain.size() - 1] == '.')) {
+          return true;
+        }
+      }
+    }
+    if (prefixes) {
+      for (auto suffix = host; !suffix.empty();) {
+        for (const auto* entry : *prefixes) {
+          if (suffix.starts_with(entry->string_view())) {
+            return true;
+          }
+        }
+        const auto dot = suffix.find('.');
+        if (dot == std::string_view::npos) {
+          break;
+        }
+        suffix.remove_prefix(dot + 1);
+      }
+    }
+    if (fragments) {
+      for (const auto* entry : *fragments) {
+        const auto fragment = entry->string_view();
+        if (document_url.spec().find(fragment) != std::string::npos ||
+            origin_url.spec().find(fragment) != std::string::npos) {
+          return true;
+        }
+      }
+    }
+    return false;
+  };
+  const bool all = exceptions->disable_all_cosmetic() ||
+      matches(exceptions->all_domains(), exceptions->all_prefixes(),
+              exceptions->all_url_substrings());
+  return {.disable_generic = all || exceptions->disable_all_generic() ||
+              matches(exceptions->generic_domains(),
+                      exceptions->generic_prefixes(),
+                      exceptions->generic_url_substrings()),
+          .disable_all = all};
+}
