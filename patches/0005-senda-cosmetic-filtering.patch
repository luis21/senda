@@ -0,0 +1,171 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/loader/senda_cosmetic_filter.h"
+
+#include <array>
+#include <string_view>
+
+#include "base/location.h"
+#include "base/task/single_thread_task_runner.h"
+#include "third_party/blink/public/platform/task_type.h"
+#include "third_party/blink/public/platform/web_document_subresource_filter.h"
+#include "third_party/blink/renderer/core/css/parser/css_parser_context.h"
+#include "third_party/blink/renderer/core/css/style_engine.h"
+#include "third_party/blink/renderer/core/css/style_sheet_contents.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/local_dom_window.h"
+#include "third_party/blink/renderer/core/loader/document_loader.h"
+#include "third_party/blink/renderer/core/loader/subresource_filter.h"
+#include "third_party/blink/renderer/platform/wtf/functional.h"
+#include "third_party/blink/renderer/platform/wtf/text/string_builder.h"
+#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
+#include "url/origin.h"
+
+namespace blink {
+namespace {
+
+#include "third_party/senda_filter_lists/CosmeticExceptions.inc"
+
+template <size_t D, size_t P, size_t U>
+bool MatchesCosmeticException(
+    std::string_view host,
+    std::string_view document_url,
+    std::string_view origin_url,
+    const std::array<std::string_view, D>& domains,
+    const std::array<std::string_view, P>& prefixes,
+    const std::array<std::string_view, U>& url_substrings) {
+  for (auto domain : domains) {
+    if (host == domain ||
+        (host.size() > domain.size() && host.ends_with(domain) &&
+         host[host.size() - domain.size() - 1] == '.')) {
+      return true;
+    }
+  }
+  // Domain anchors may start at a parent hostname boundary.
+  for (auto suffix = host; !suffix.empty();) {
+    for (auto prefix : prefixes) {
+      if (suffix.starts_with(prefix)) {
+        return true;
+      }
+    }
+    const auto dot = suffix.find('.');
+    if (dot == std::string_view::npos) {
+      break;
+    }
+    suffix.remove_prefix(dot + 1);
+  }
+  for (auto fragment : url_substrings) {
+    if (document_url.find(fragment) != std::string_view::npos ||
+        origin_url.find(fragment) != std::string_view::npos) {
+      return true;
+    }
+  }
+  return false;
+}
+
+}  // namespace
+
+const char SendaCosmeticFilter::kSupplementName[] = "SendaCosmeticFilter";
+SendaCosmeticFilter::SendaCosmeticFilter(
+    Document& document,
+    SubresourceFilter* owner,
+    WebDocumentSubresourceFilter* filter)
+    : Supplement<Document>(document), owner_(owner), subresource_filter_(filter) {}
+
+SendaCosmeticFilter* SendaCosmeticFilter::FromIfExists(Document& document) {
+  return Supplement<Document>::From<SendaCosmeticFilter>(document);
+}
+
+void SendaCosmeticFilter::Initialize() {
+  if (subresource_filter_->IsDryRun()) {
+    return;
+  }
+  const auto& document = *GetSupplementable();
+  if (!document.domWindow()) {
+    generic_cosmetic_disabled_ = true;
+    return;
+  }
+  const auto* origin = document.domWindow()->GetSecurityOrigin()
+                           ->GetOriginOrPrecursorOriginIfOpaque();
+  const std::string host = origin->Host().Utf8();
+  const std::string document_url = document.Url().GetString().Utf8();
+  const std::string origin_url = origin->ToUrlOrigin().GetURL().spec();
+  const bool all_disabled = kSendaDisableAllCosmetic || MatchesCosmeticException(
+      host, document_url, origin_url, kSendaAllCosmeticDomains,
+      kSendaAllCosmeticHostPrefixes, kSendaAllCosmeticUrlSubstrings);
+  generic_cosmetic_disabled_ = all_disabled || kSendaDisableAllGenericCosmetic ||
+      MatchesCosmeticException(host, document_url, origin_url,
+          kSendaGenericCosmeticDomains, kSendaGenericCosmeticHostPrefixes,
+          kSendaGenericCosmeticUrlSubstrings);
+  if (all_disabled) {
+    return;
+  }
+  std::vector<std::string_view> selectors;
+  subresource_filter_->GetDomainSelectors(selectors);
+  QueueCosmeticSelectors(selectors);
+}
+
+void SendaCosmeticFilter::ObserveName(const AtomicString& name, bool is_id) {
+  // The bundled generic selectors use ASCII anchors. Its AtomicString hash
+  // matches the ruleset index, avoiding allocations for ordinary attributes.
+  if (generic_cosmetic_disabled_ || name.empty() ||
+      !name.GetString().ContainsOnlyAsciiOrEmpty() ||
+      subresource_filter_->IsDryRun() ||
+      !subresource_filter_->MaybeHasStyleRule(name.Hash())) {
+    return;
+  }
+  std::vector<std::string_view> selectors;
+  const auto utf8_name = name.Utf8();
+  if (is_id) {
+    subresource_filter_->GetSelectorsById(utf8_name, name.Hash(), selectors);
+  } else {
+    subresource_filter_->GetSelectorsByClass(utf8_name, name.Hash(), selectors);
+  }
+  QueueCosmeticSelectors(selectors);
+}
+
+void SendaCosmeticFilter::QueueCosmeticSelectors(
+    const std::vector<std::string_view>& selectors) {
+  bool changed = false;
+  for (auto selector : selectors) {
+    changed |= cosmetic_selectors_.insert(String::FromUtf8(selector)).is_new_entry;
+  }
+  if (!changed || cosmetic_update_pending_) {
+    return;
+  }
+  cosmetic_update_pending_ = true;
+  GetSupplementable()->GetTaskRunner(TaskType::kInternalLoading)->PostTask(
+      FROM_HERE, BindOnce(&SendaCosmeticFilter::ApplyCosmeticSelectors,
+                          WrapWeakPersistent(this)));
+}
+
+void SendaCosmeticFilter::ApplyCosmeticSelectors() {
+  cosmetic_update_pending_ = false;
+  Document& document = *GetSupplementable();
+  if (!document.IsActive() || !document.GetFrame() || !document.Loader() ||
+      document.Loader()->GetSubresourceFilter() != owner_.Get()) {
+    return;
+  }
+  StringBuilder css;
+  for (const auto& selector : cosmetic_selectors_) {
+    css.Append(selector);
+    css.Append("{display:none!important;}\n");
+  }
+  auto* sheet = MakeGarbageCollected<StyleSheetContents>(
+      MakeGarbageCollected<CSSParserContext>(document));
+  sheet->ParseString(css.ToString());
+  const AtomicString key("senda-cosmetic-filter");
+  if (cosmetic_sheet_injected_) {
+    document.GetStyleEngine().RemoveInjectedSheet(key, WebCssOrigin::kUser);
+  }
+  document.GetStyleEngine().InjectSheet(key, sheet, WebCssOrigin::kUser);
+  cosmetic_sheet_injected_ = true;
+}
+
+void SendaCosmeticFilter::Trace(Visitor* visitor) const {
+  visitor->Trace(owner_);
+  Supplement<Document>::Trace(visitor);
+}
+}  // namespace blink
