+#include "third_party/blink/renderer/platform/wtf/text/string_hash.h"
+
+namespace blink {
+class Document;
+class SubresourceFilter;
+class WebDocumentSubresourceFilter;
+
+class CORE_EXPORT SendaCosmeticFilter final
+    : public GarbageCollected<SendaCosmeticFilter>, public Supplement<Document> {
+ public:
+  static const char kSupplementName[];
+  SendaCosmeticFilter(Document&, SubresourceFilter*, WebDocumentSubresourceFilter*);
+  static SendaCosmeticFilter* FromIfExists(Document&);
+  void Initialize();
+  void ObserveName(const AtomicString&, bool is_id);
+  void Trace(Visitor*) const override;
+
+ private:
+  void QueueCosmeticSelectors(const std::vector<std::string_view>&);
+  void ApplyCosmeticSelectors();
+  // Keep the native filter alive for as long as its borrowed interface is used.
+  Member<SubresourceFilter> owner_;
+  WebDocumentSubresourceFilter* subresource_filter_;
+  HashSet<String> cosmetic_selectors_;
+  bool cosmetic_update_pending_ = false;
+  bool cosmetic_sheet_injected_ = false;
+  bool generic_cosmetic_disabled_ = false;
+};
+}  // namespace blink
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_LOADER_SENDA_COSMETIC_FILTER_H_
diff --git a/third_party/blink/renderer/core/loader/senda_cosmetic_filter.cc b/third_party/blink/renderer/core/loader/senda_cosmetic_filter.cc
