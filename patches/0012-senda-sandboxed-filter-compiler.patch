+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+module senda.mojom;
+import "mojo/public/mojom/base/file.mojom";
+import "sandbox/policy/mojom/sandbox.mojom";
+
+enum FilterCompileStatus { kSuccess, kInvalidSource, kLimitExceeded, kWriteFailure };
+struct FilterCompileResult {
+  FilterCompileStatus status;
+  array<string, 2> versions;
+  array<string, 2> source_hashes;
+  string ruleset_sha256;
+  uint32 network_rules;
+  uint32 cosmetic_rules;
+};
+
+[ServiceSandbox=sandbox.mojom.Sandbox.kService]
+interface FilterCompiler {
+  Compile(mojo_base.mojom.ReadOnlyFile easylist,
+          mojo_base.mojom.ReadOnlyFile easyprivacy,
+          mojo_base.mojom.File output) => (FilterCompileResult result);
+};
