@@ -0,0 +1,33 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "components/subresource_filter/content/utility/senda_filter_compiler_impl.h"
+#include <utility>
+#include "components/subresource_filter/tools/rule_parser/senda_filter_compiler.h"
+namespace subresource_filter {
+SendaFilterCompilerImpl::SendaFilterCompilerImpl(
+    mojo::PendingReceiver<senda::mojom::FilterCompiler> receiver)
+    : receiver_(this, std::move(receiver)) {}
+SendaFilterCompilerImpl::~SendaFilterCompilerImpl() = default;
+void SendaFilterCompilerImpl::Compile(base::File easylist, base::File easyprivacy,
+                                     base::File output, CompileCallback callback) {
+  auto result = CompileSendaFilters(std::move(easylist), std::move(easyprivacy),
+                                    std::move(output));
+  auto reply = senda::mojom::FilterCompileResult::New();
+  switch (result.status) {
+    case CompileStatus::kSuccess:
+      reply->status = senda::mojom::FilterCompileStatus::kSuccess; break;
+    case CompileStatus::kInvalidSource:
+      reply->status = senda::mojom::FilterCompileStatus::kInvalidSource; break;
+    case CompileStatus::kLimitExceeded:
+      reply->status = senda::mojom::FilterCompileStatus::kLimitExceeded; break;
+    case CompileStatus::kWriteFailure:
+      reply->status = senda::mojom::FilterCompileStatus::kWriteFailure; break;
+  }
+  reply->versions.assign(result.versions.begin(), result.versions.end());
+  reply->source_hashes.assign(result.source_hashes.begin(), result.source_hashes.end());
+  reply->ruleset_sha256 = std::move(result.ruleset_sha256);
+  reply->network_rules = result.network_rules;
+  reply->cosmetic_rules = result.cosmetic_rules;
+  std::move(callback).Run(std::move(reply));
+}
