+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#ifndef COMPONENTS_SUBRESOURCE_FILTER_TOOLS_RULE_PARSER_SENDA_FILTER_COMPILER_H_
+#define COMPONENTS_SUBRESOURCE_FILTER_TOOLS_RULE_PARSER_SENDA_FILTER_COMPILER_H_
+#include <array>
+#include <string>
+#include "base/files/file.h"
+namespace subresource_filter {
+enum class CompileStatus { kSuccess, kInvalidSource, kLimitExceeded, kWriteFailure };
+struct CompileResult {
+  CompileStatus status = CompileStatus::kInvalidSource;
+  std::array<std::string, 2> versions;
+  std::array<std::string, 2> source_hashes;
+  std::string ruleset_sha256;
+  uint32_t network_rules = 0;
+  uint32_t cosmetic_rules = 0;
+  // Conservative accounting for staged selector text and tree nodes, not RSS.
+  uint32_t peak_style_bytes = 0;
+};
+CompileResult CompileSendaFilters(base::File easylist,
+                                 base::File easyprivacy,
+                                 base::File output);
+}  // namespace subresource_filter
+#endif
diff --git a/components/subresource_filter/tools/rule_parser/senda_filter_compiler.cc b/components/subresource_filter/tools/rule_parser/senda_filter_compiler.cc
new file mode 100644
--- /dev/null
+++ b/components/subresource_filter/tools/rule_parser/senda_filter_compiler.cc
@@ -0,0 +1,374 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "components/subresource_filter/tools/rule_parser/senda_filter_compiler.h"
+
+#include <algorithm>
+#include <set>
+#include <string_view>
+#include <utility>
+#include <vector>
+#include "base/containers/span.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/time/time.h"
+#include "components/subresource_filter/core/common/unindexed_ruleset.h"
+#include "components/subresource_filter/tools/rule_parser/rule_parser.h"
+#include "components/subresource_filter/tools/ruleset_converter/rule_stream.h"
+#include "crypto/hash.h"
+#include "third_party/protobuf/src/google/protobuf/io/zero_copy_stream_impl_lite.h"
+
+namespace subresource_filter {
+namespace {
+namespace proto = url_pattern_index::proto;
+constexpr size_t kSourceLimit = 20 * 1024 * 1024;
+constexpr size_t kLineLimit = 64 * 1024;
+constexpr size_t kLineCountLimit = 1000000;
+constexpr size_t kMetadataLimit = 1024 * 1024;
+
+bool Domain(std::string_view value) {
+  return !value.empty() && std::ranges::all_of(value, [](char c) {
+    return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '_' ||
+           c == '.' || c == '-';
+  });
+}
+
+bool Selector(std::string_view value) {
+  if (value.empty() || !base::IsStringASCII(value) ||
+      std::ranges::any_of(value, [](char c) { return c < 32 || c == 127; })) {
+    return false;
+  }
+  for (auto token : {"{", "}", "/*", "*/", "@", ":style(", ":-abp-",
+                     ":has-text(", ":matches-css("}) {
+    if (value.find(token) != std::string_view::npos) {
+      return false;
+    }
+  }
+  char quote = 0;
+  bool escaped = false;
+  int brackets = 0, parentheses = 0;
+  for (char c : value) {
+    if (escaped) { escaped = false; continue; }
+    if (c == '\\') { escaped = true; continue; }
+    if (quote) {
+      if (c == quote) { quote = 0; }
+      continue;
+    }
+    if (c == '\'' || c == '"') { quote = c; continue; }
+    if (c == ';') { return false; }
+    if (c == '[') { ++brackets; }
+    if (c == ']' && --brackets < 0) { return false; }
+    if (c == '(') { ++parentheses; }
+    if (c == ')' && --parentheses < 0) { return false; }
+  }
+  return !quote && !escaped && brackets == 0 && parentheses == 0;
+}
+
+// Iteration never allocates a vector proportional to the number of lines.
+template <typename Callback>
+CompileStatus Lines(std::string_view text, Callback callback) {
+  size_t number = 0;
+  while (!text.empty()) {
+    const auto end = text.find('\n');
+    auto line = text.substr(0, end);
+    if (line.size() > kLineLimit || ++number > kLineCountLimit) {
+      return CompileStatus::kLimitExceeded;
+    }
+    if (line.ends_with('\r')) {
+      line.remove_suffix(1);
+    }
+    if (!callback(line, number)) {
+      return CompileStatus::kInvalidSource;
+    }
+    if (end == std::string_view::npos) {
+      break;
+    }
+    text.remove_prefix(end + 1);
+  }
+  return CompileStatus::kSuccess;
+}
+
+bool Version(std::string_view value) {
+  if (value.size() != 12 || !std::ranges::all_of(value, base::IsAsciiDigit<char>)) {
+    return false;
+  }
+  base::Time::Exploded exploded = {};
+  if (!base::StringToInt(value.substr(0, 4), &exploded.year) ||
+      !base::StringToInt(value.substr(4, 2), &exploded.month) ||
+      !base::StringToInt(value.substr(6, 2), &exploded.day_of_month) ||
+      !base::StringToInt(value.substr(8, 2), &exploded.hour) ||
+      !base::StringToInt(value.substr(10, 2), &exploded.minute)) {
+    return false;
+  }
+  base::Time parsed;
+  if (!base::Time::FromUTCExploded(exploded, &parsed)) {
+    return false;
+  }
+  base::Time::Exploded actual;
+  parsed.UTCExplode(&actual);
+  return actual.year == exploded.year && actual.month == exploded.month &&
+         actual.day_of_month == exploded.day_of_month && actual.hour == exploded.hour &&
+         actual.minute == exploded.minute;
+}
+
+CompileStatus ReadSource(base::File& file, std::string_view title,
+                         std::string& text, std::string& version,
+                         std::string& hash) {
+  const auto size = file.GetLength();
+  if (size > static_cast<int64_t>(kSourceLimit)) {
+    return CompileStatus::kLimitExceeded;
+  }
+  if (size < 1024) {
+    return CompileStatus::kInvalidSource;
+  }
+  text.resize(size);
+  if (!file.ReadAndCheck(0, base::as_writable_byte_span(text)) || !base::IsStringUTF8(text)) {
+    return CompileStatus::kInvalidSource;
+  }
+  hash = base::HexEncodeLower(crypto::hash::Sha256(text));
+  std::string_view view = text;
+  if (view.starts_with("\xef\xbb\xbf")) {
+    view.remove_prefix(3);
+  }
+  if (!view.starts_with("[Adblock Plus ")) {
+    return CompileStatus::kInvalidSource;
+  }
+  bool found_title = false;
+  size_t versions = 0, rules = 0;
+  auto status = Lines(view, [&](std::string_view line, size_t number) {
+    if (number <= 20) {
+      found_title |= line == std::string("! Title: ") + std::string(title);
+      if (line.starts_with("! Version: ")) {
+        ++versions;
+        version = line.substr(11);
+      }
+    }
+    rules += !line.empty() && !line.starts_with('!') && !line.starts_with('[');
+    return true;
+  });
+  if (status != CompileStatus::kSuccess) {
+    return status;
+  }
+  return found_title && versions == 1 && Version(version) && rules >= 100
+             ? CompileStatus::kSuccess : CompileStatus::kInvalidSource;
+}
+
+struct Exceptions {
+  // Same field ordering as CosmeticExceptions in rules.proto.
+  std::array<std::set<std::string>, 6> values;
+  bool generic = false, all = false;
+  size_t bytes = 0;
+  void Add(size_t field, std::string_view value) {
+    if (bytes <= kMetadataLimit && values[field].insert(std::string(value)).second) {
+      bytes += value.size() + 8;
+    }
+  }
+  void Parse(std::string_view line) {
+    const auto dollar = line.rfind('$');
+    if (!line.starts_with("@@") || dollar == std::string_view::npos) {
+      return;
+    }
+    const auto lower = base::ToLowerASCII(line.substr(dollar + 1));
+    const auto options = base::SplitStringPiece(lower, ",", base::KEEP_WHITESPACE,
+                                               base::SPLIT_WANT_ALL);
+    bool full = false, global = false;
+    for (auto option : options) {
+      if (option.starts_with('~')) {
+        option.remove_prefix(1);
+      }
+      full |= option == "elemhide" || option == "ehide" ||
+              option == "specifichide" || option == "shide";
+      global |= option == "generichide" || option == "ghide";
+    }
+    if (!full && !global) {
+      return;
+    }
+    const size_t category = full ? 1 : 0;
+    auto pattern = line.substr(2, dollar - 2);
+    bool covered = false;
+    if (pattern.starts_with("||")) {
+      const auto host_end = pattern.find_first_of("^/:?", 2);
+      const auto host = base::ToLowerASCII(pattern.substr(2, host_end - 2));
+      if (Domain(host)) {
+        Add(category + (host_end == std::string_view::npos ? 2 : 0), host);
+        covered = true;
+      } else if (host.ends_with('*') && Domain(std::string_view(host).substr(0, host.size() - 1))) {
+        Add(category + 2, std::string_view(host).substr(0, host.size() - 1));
+        covered = true;
+      }
+    } else if (pattern.starts_with("://") && pattern.size() > 3 &&
+               std::ranges::all_of(pattern.substr(3), [](char c) {
+                 return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) ||
+                        std::string_view("_.:/-").contains(c);
+               })) {
+      Add(category + 4, pattern);
+      covered = true;
+    } else if (pattern.empty()) {
+      size_t domain_options = 0;
+      std::vector<std::string_view> domains;
+      for (auto option : options) {
+        if (option.starts_with("domain=")) {
+          ++domain_options;
+          domains = base::SplitStringPiece(option.substr(7), "|", base::KEEP_WHITESPACE,
+                                           base::SPLIT_WANT_ALL);
+        }
+      }
+      bool valid = domain_options == 1;
+      bool any = false;
+      for (auto domain : domains) {
+        if (!domain.starts_with('~')) {
+          any = true;
+          valid &= Domain(domain);
+        }
+      }
+      if (valid && any) {
+        for (auto domain : domains) {
+          if (!domain.starts_with('~')) {
+            Add(category, domain);
+          }
+        }
+        covered = true;
+      }
+    }
+    if (!covered) {
+      (full ? all : generic) = true;
+    }
+  }
+  proto::CosmeticExceptions ToProto() const {
+    proto::CosmeticExceptions result;
+    auto copy = [](const auto& source, auto* target) {
+      for (const auto& value : source) { *target->Add() = value; }
+    };
+    copy(values[0], result.mutable_generic_domains());
+    copy(values[1], result.mutable_all_domains());
+    copy(values[2], result.mutable_generic_prefixes());
+    copy(values[3], result.mutable_all_prefixes());
+    copy(values[4], result.mutable_generic_url_substrings());
+    copy(values[5], result.mutable_all_url_substrings());
+    result.set_disable_all_generic(generic);
+    result.set_disable_all_cosmetic(all);
+    return result;
+  }
+};
+
+bool InsertStyle(std::set<std::string>& target, std::string rule,
+                 uint32_t& buffered_bytes) {
+  if (target.contains(rule)) { return true; }
+  const auto cost = rule.size() + 64;
+  if (cost > kSourceLimit - buffered_bytes) { return false; }
+  buffered_bytes += cost;
+  target.insert(std::move(rule));
+  return true;
+}
+
+bool NormalizeStyle(std::string_view line, std::set<std::string>& rules,
+                    std::set<std::string>& unsafe, uint32_t& buffered_bytes) {
+  const auto exception = line.find("#@#");
+  const bool allow = exception != std::string_view::npos;
+  const auto marker = allow ? exception : line.find("##");
+  if (marker == std::string_view::npos) {
+    return true;
+  }
+  const auto selector = line.substr(marker + (allow ? 3 : 2));
+  const auto domain_text = line.substr(0, marker);
+  const auto domains = base::SplitStringPiece(domain_text, ",", base::KEEP_WHITESPACE,
+                                             base::SPLIT_WANT_NONEMPTY);
+  bool valid = Selector(selector);
+  std::string positive;
+  for (auto domain : domains) {
+    bool negative = domain.starts_with('~');
+    valid &= Domain(negative ? domain.substr(1) : domain);
+    valid &= !allow || !negative;
+    if (!negative) {
+      if (!positive.empty()) { positive += ','; }
+      positive += domain;
+    }
+  }
+  valid &= !allow || !domains.empty();
+  if (!valid) {
+    return !allow || InsertStyle(unsafe, std::string(selector), buffered_bytes);
+  }
+  if (!InsertStyle(rules, positive + (allow ? "#@#" : "##") + std::string(selector),
+                    buffered_bytes)) { return false; }
+  if (!allow) {
+    for (auto domain : domains) {
+      if (domain.starts_with('~')) {
+        if (!InsertStyle(rules, std::string(domain.substr(1)) + "#@#" +
+                                 std::string(selector), buffered_bytes)) { return false; }
+      }
+    }
+  }
+  return true;
+}
+}  // namespace
+
+CompileResult CompileSendaFilters(base::File easylist, base::File easyprivacy,
+                                 base::File output) {
+  CompileResult result;
+  if (!output.IsValid()) {
+    result.status = CompileStatus::kWriteFailure;
+    return result;
+  }
+  std::array<std::string, 2> sources;
+  result.status = ReadSource(easylist, "EasyList", sources[0], result.versions[0], result.source_hashes[0]);
+  if (result.status != CompileStatus::kSuccess) { return result; }
+  result.status = ReadSource(easyprivacy, "EasyPrivacy", sources[1], result.versions[1], result.source_hashes[1]);
+  if (result.status != CompileStatus::kSuccess) { return result; }
+  std::string encoded;
+  Exceptions exceptions;
+  std::set<std::string> styles, unsafe;
+  RuleParser parser;
+  bool limit = false;
+  {
+    google::protobuf::io::StringOutputStream stream(&encoded);
+    UnindexedRulesetWriter writer(&stream);
+    for (const auto& text : sources) {
+      Lines(text, [&](std::string_view line, size_t) {
+        exceptions.Parse(line);
+        if (line.contains("##") || line.contains("#@#")) {
+          limit |= !NormalizeStyle(line, styles, unsafe, result.peak_style_bytes);
+        } else if (parser.Parse(line) == proto::RULE_TYPE_URL) {
+          auto rule = parser.url_rule().ToProtobuf();
+          if (!DeleteUrlRuleOrAmend(&rule, 59)) {
+            writer.AddUrlRule(rule);
+            ++result.network_rules;
+          }
+        }
+        limit |= encoded.size() > kSourceLimit || exceptions.bytes > kMetadataLimit;
+        return !limit;
+      });
+      if (limit) { break; }
+    }
+    // Domain-specific rules must precede generic rules in the style index.
+    for (bool generic : {false, true}) {
+      for (const auto& line : styles) {
+        if (limit) { break; }
+        if (line.starts_with("##") != generic) { continue; }
+        const auto marker = line.find(line.contains("#@#") ? "#@#" : "##");
+        const auto selector = line.substr(marker + (line.contains("#@#") ? 3 : 2));
+        if (unsafe.contains(selector) || parser.Parse(line) != proto::RULE_TYPE_STYLE) { continue; }
+        auto rule = parser.style_rule().ToProtobuf();
+        if (!DeleteStyleRuleOrAmend(&rule)) {
+          writer.AddStyleRule(rule);
+          ++result.cosmetic_rules;
+        }
+        limit |= encoded.size() > kSourceLimit;
+      }
+    }
+    writer.SetCosmeticExceptions(exceptions.ToProto());
+    writer.Finish();
+  }
+  if (limit || encoded.size() > kSourceLimit) {
+    result.status = CompileStatus::kLimitExceeded;
+  } else if (result.network_rules < 1000) {
+    result.status = CompileStatus::kInvalidSource;
+  } else if (!output.SetLength(0) || output.Seek(base::File::FROM_BEGIN, 0) != 0 ||
+             !output.WriteAtCurrentPosAndCheck(base::as_byte_span(encoded)) || !output.Flush()) {
+    result.status = CompileStatus::kWriteFailure;
+  } else {
+    result.ruleset_sha256 = base::HexEncodeLower(crypto::hash::Sha256(encoded));
+    result.status = CompileStatus::kSuccess;
+  }
+  return result;
+}
+}  // namespace subresource_filter
