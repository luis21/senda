+#include "components/subresource_filter/tools/rule_parser/senda_filter_compiler.h"
+#include <iostream>
+#include "base/command_line.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "base/time/time.h"
+#include "components/subresource_filter/core/common/indexed_ruleset.h"
+#include "components/subresource_filter/core/common/unindexed_ruleset.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/protobuf/src/google/protobuf/io/zero_copy_stream_impl_lite.h"
+
+namespace subresource_filter {
+TEST(SendaOfficialSourcesTest, CompilesAndIndexesSuppliedListFiles) {
+  const auto* args = base::CommandLine::ForCurrentProcess();
+  if (!args->HasSwitch("senda-easylist") || !args->HasSwitch("senda-easyprivacy")) {
+    GTEST_SKIP() << "Pass --senda-easylist and --senda-easyprivacy for real-source validation";
+  }
+  base::ScopedTempDir directory;
+  ASSERT_TRUE(directory.CreateUniqueTempDir());
+  const auto output = directory.GetPath().AppendASCII("rules");
+  const auto start = base::TimeTicks::Now();
+  const auto result = CompileSendaFilters(
+      base::File(args->GetSwitchValuePath("senda-easylist"), base::File::FLAG_OPEN | base::File::FLAG_READ),
+      base::File(args->GetSwitchValuePath("senda-easyprivacy"), base::File::FLAG_OPEN | base::File::FLAG_READ),
+      base::File(output, base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE));
+  ASSERT_EQ(CompileStatus::kSuccess, result.status);
+  EXPECT_GE(result.network_rules, 1000u);
+  EXPECT_GT(result.cosmetic_rules, 0u);
+  std::string encoded;
+  ASSERT_TRUE(base::ReadFileToString(output, &encoded));
+  google::protobuf::io::ArrayInputStream input(encoded.data(), encoded.size());
+  UnindexedRulesetReader reader(&input);
+  url_pattern_index::proto::FilteringRules chunk;
+  RulesetIndexer index(42);
+  size_t exceptions = 0;
+  while (reader.ReadNextChunk(&chunk)) {
+    for (const auto& rule : chunk.url_rules()) { index.AddUrlRule(rule); }
+    for (const auto& rule : chunk.style_rules()) { index.AddStyleRuleFromProto(rule); }
+    if (chunk.has_cosmetic_exceptions()) {
+      ++exceptions;
+      index.SetCosmeticExceptions(chunk.cosmetic_exceptions());
+    }
+  }
+  EXPECT_EQ(1u, exceptions);
+  EXPECT_EQ(encoded.size(), static_cast<size_t>(reader.num_bytes_read()));
+  index.Finish();
+  EXPECT_TRUE(IndexedRulesetMatcher::Verify(index.data(), index.GetChecksum(), "Senda.Test"));
+  std::cout << "SENDA_COMPILER network=" << result.network_rules
+            << " cosmetic=" << result.cosmetic_rules
+            << " bytes=" << encoded.size()
+            << " elapsed_ms=" << (base::TimeTicks::Now() - start).InMilliseconds()
+            << " sha256=" << result.ruleset_sha256 << std::endl;
+}
