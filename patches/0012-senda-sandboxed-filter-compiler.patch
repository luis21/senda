@@ -0,0 +1,114 @@
+// Copyright 2026 The Senda Authors
+// Use of this source code is governed by a BSD-style license.
+#include "components/subresource_filter/tools/rule_parser/senda_filter_compiler.h"
+#include "base/files/file_util.h"
+#include "base/files/scoped_temp_dir.h"
+#include "components/subresource_filter/core/common/unindexed_ruleset.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/protobuf/src/google/protobuf/io/zero_copy_stream_impl_lite.h"
+
+namespace subresource_filter {
+namespace {
+std::string Source(std::string_view title, std::string_view extra = "") {
+  std::string text = "[Adblock Plus 2.0]\n! Title: " + std::string(title) +
+                     "\n! Version: 202611170028\n";
+  for (int i = 0; i < 600; ++i) {
+    text += "||ads" + std::to_string(i) + ".test^\n";
+  }
+  return text + std::string(extra);
+}
+class SendaCompilerTest : public testing::Test {
+ protected:
+  void SetUp() override { ASSERT_TRUE(dir_.CreateUniqueTempDir()); }
+  CompileResult Compile(std::string first, std::string second) {
+    auto list = dir_.GetPath().AppendASCII("easylist");
+    auto privacy = dir_.GetPath().AppendASCII("easyprivacy");
+    EXPECT_TRUE(base::WriteFile(list, first));
+    EXPECT_TRUE(base::WriteFile(privacy, second));
+    return CompileSendaFilters(
+        base::File(list, base::File::FLAG_OPEN | base::File::FLAG_READ),
+        base::File(privacy, base::File::FLAG_OPEN | base::File::FLAG_READ),
+        base::File(dir_.GetPath().AppendASCII("rules"),
+                   base::File::FLAG_CREATE_ALWAYS | base::File::FLAG_WRITE));
+  }
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(SendaCompilerTest, PreservesNetworkCosmeticsAndActivationExceptions) {
+  auto result = Compile(Source("EasyList", "##.ad\n~keep.test##.promo\n"
+      "site.test#@#.ad\n@@||nohide.test^$generichide\n"), Source("EasyPrivacy"));
+  ASSERT_EQ(CompileStatus::kSuccess, result.status);
+  EXPECT_EQ(1200u, result.network_rules);
+  EXPECT_EQ("202611170028", result.versions[0]);
+  std::string encoded;
+  ASSERT_TRUE(base::ReadFileToString(dir_.GetPath().AppendASCII("rules"), &encoded));
+  google::protobuf::io::ArrayInputStream input(encoded.data(), encoded.size());
+  UnindexedRulesetReader reader(&input);
+  url_pattern_index::proto::FilteringRules chunk;
+  size_t styles = 0;
+  bool activation_found = false;
+  while (reader.ReadNextChunk(&chunk)) {
+    styles += chunk.style_rules_size();
+    if (chunk.has_cosmetic_exceptions()) {
+      ASSERT_EQ(1, chunk.cosmetic_exceptions().generic_domains_size());
+      EXPECT_EQ("nohide.test", chunk.cosmetic_exceptions().generic_domains(0));
+      activation_found = true;
+    }
+  }
+  EXPECT_TRUE(activation_found);
+  EXPECT_EQ(4u, styles);
+}
+
+TEST_F(SendaCompilerTest, RejectsInvalidSourcesAndLimits) {
+  EXPECT_EQ(CompileStatus::kInvalidSource,
+            Compile("<html>error</html>", Source("EasyPrivacy")).status);
+  EXPECT_EQ(CompileStatus::kInvalidSource,
+            Compile(Source("Other"), Source("EasyPrivacy")).status);
+  EXPECT_EQ(CompileStatus::kInvalidSource,
+            Compile(Source("EasyList", "\xff"), Source("EasyPrivacy")).status);
+  EXPECT_EQ(CompileStatus::kLimitExceeded,
+            Compile(Source("EasyList", std::string(65537, 'a')),
+                    Source("EasyPrivacy")).status);
+  EXPECT_EQ(CompileStatus::kLimitExceeded,
+            Compile(std::string(20 * 1024 * 1024 + 1, 'a'),
+                    Source("EasyPrivacy")).status);
+}
+
+TEST_F(SendaCompilerTest, UnknownExceptionAndUnsafeSelectorsPreferUnderblocking) {
+  auto result = Compile(Source("EasyList", "##.bad {color:red}\n##.ad\n"
+      "~invalid.test#@#.ad\n##.safe\n@@/unknown-regex/$elemhide\n"), Source("EasyPrivacy"));
+  ASSERT_EQ(CompileStatus::kSuccess, result.status);
+  EXPECT_EQ(1u, result.cosmetic_rules);
+}
+
+TEST_F(SendaCompilerTest, InvalidOutputReturnsFailureInsteadOfCrashing) {
+  auto list = dir_.GetPath().AppendASCII("list");
+  auto privacy = dir_.GetPath().AppendASCII("privacy");
+  ASSERT_TRUE(base::WriteFile(list, Source("EasyList")));
+  ASSERT_TRUE(base::WriteFile(privacy, Source("EasyPrivacy")));
+  auto result = CompileSendaFilters(
+      base::File(list, base::File::FLAG_OPEN | base::File::FLAG_READ),
+      base::File(privacy, base::File::FLAG_OPEN | base::File::FLAG_READ), base::File());
+  EXPECT_EQ(CompileStatus::kWriteFailure, result.status);
+}
+
+TEST_F(SendaCompilerTest, NegativeDomainsCannotAmplifyBufferedSelectorsWithoutLimit) {
+  std::string domains;
+  for (int i = 0; i < 700; ++i) {
+    if (i) { domains += ','; }
+    domains += "~d" + std::to_string(i) + ".test";
+  }
+  auto result = Compile(Source("EasyList", domains + "##." +
+      std::string(40000, 'a') + "\n"), Source("EasyPrivacy"));
+  EXPECT_EQ(CompileStatus::kLimitExceeded, result.status);
+  EXPECT_LE(result.peak_style_bytes, 20u * 1024 * 1024);
+}
+
+TEST_F(SendaCompilerTest, QuotedAttributeValuesCanContainSemicolons) {
+  auto result = Compile(Source("EasyList",
+      "site.test##[style=\"display: block;\"]\n##.ad;body\n"), Source("EasyPrivacy"));
+  ASSERT_EQ(CompileStatus::kSuccess, result.status);
+  EXPECT_EQ(1u, result.cosmetic_rules);
+}
+}  // namespace
+}  // namespace subresource_filter
