 namespace {
 
+// Hold the first web navigation until the packaged rules have been verified
+// and distributed. Internal pages remain available if protection cannot start.
+class SendaProtectionReadyThrottle : public content::NavigationThrottle {
+ public:
+  explicit SendaProtectionReadyThrottle(
+      content::NavigationThrottleRegistry& registry)
+      : content::NavigationThrottle(registry) {}
+
+  ThrottleCheckResult WillStartRequest() override { return CheckReadiness(); }
+  ThrottleCheckResult WillRedirectRequest() override { return CheckReadiness(); }
+  const char* GetNameForLogging() override {
+    return "SendaProtectionReadyThrottle";
+  }
+
+ private:
+  ThrottleCheckResult CheckReadiness() {
+    const GURL& url = navigation_handle()->GetURL();
+    if (!url.SchemeIsHTTPOrHTTPS() ||
+        !base::FeatureList::IsEnabled(
+            subresource_filter::kSafeBrowsingSubresourceFilter)) {
+      return PROCEED;
+    }
+    Profile* profile = Profile::FromBrowserContext(
+        navigation_handle()->GetWebContents()->GetBrowserContext());
+    if (HostContentSettingsMapFactory::GetForProfile(profile)->GetContentSetting(
+            url, GURL(), ContentSettingsType::ADS) == CONTENT_SETTING_ALLOW) {
+      return PROCEED;
+    }
+    auto* service = g_browser_process->subresource_filter_ruleset_service();
+    if (service && service->HasPublishedRuleset()) {
+      return PROCEED;
+    }
+    if (service) {
+      subscription_ = service->WhenRulesetReady(
+          base::BindOnce(&SendaProtectionReadyThrottle::OnReady,
+                         weak_factory_.GetWeakPtr()));
+    }
+    timeout_.Start(FROM_HERE, base::Seconds(30), this,
+                   &SendaProtectionReadyThrottle::OnTimeout);
+    return DEFER;
+  }
+
+  void OnReady() {
+    timeout_.Stop();
+    Resume();
+  }
+
+  void OnTimeout() {
+    CancelDeferredNavigation(
+        {CANCEL, net::ERR_BLOCKED_BY_CLIENT,
+         std::string("<!doctype html><html lang=es><meta charset=utf-8>"
+                     "<title>Senda: proteccion no disponible</title>"
+                     "<h1>La proteccion todavia no esta lista</h1>"
+                     "<p>Recarga la pagina o reinicia Senda para volver a "
+                     "intentarlo.</p></html>")});
+  }
+
+  base::CallbackListSubscription subscription_;
+  base::OneShotTimer timeout_;
+  base::WeakPtrFactory<SendaProtectionReadyThrottle> weak_factory_{this};
+};
